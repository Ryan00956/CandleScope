# Replay release gates hash these assets byte-for-byte. Keep checkout bytes
# stable across Windows and Unix even when core.autocrlf is enabled.
backend/tests/fixtures/replay/*.json text eol=lf
docs/perf-baselines/replay-*.json text eol=lf
frontend/scripts/replay-rollback-drill.* text eol=lf

# Plugin Platform Phase 0 freezes these fixtures by exact SHA-256.
backend/app/official-plugin-releases.json text eol=lf
backend/app/plugin_runtime_registry_v3/official-runtime-registry*.json text eol=lf
backend/tests/fixtures/plugin_runtime/pyne_transport_v1.json text eol=lf
packages/candlescope-plugin-sdk/tests/fixtures/hello_transcript_v1.json text eol=lf

# Plugin Platform multi-runtime gates sign and hash these checked-in sources,
# registry documents, fixtures, and reference-adapter receipts byte-for-byte.
# Pin their reviewed line endings so core.autocrlf cannot invalidate evidence.
backend/app/plugin_live_v2/*.json text eol=lf
backend/app/plugin_runtime_registry_v3/*.json text eol=lf
backend/tests/fixtures/plugin_platform_multi_runtime/** text eol=lf
backend/tests/fixtures/plugin_platform_v2/*.json text eol=lf
docs/plugin-adapters/*.json text eol=lf
examples/plugins/aho-corasick-adapter/**/*.json text eol=lf
examples/plugins/aho-corasick-adapter/**/*.lock text eol=lf
examples/plugins/aho-corasick-adapter/**/*.md text eol=lf
examples/plugins/aho-corasick-adapter/**/*.py text eol=lf
examples/plugins/aho-corasick-adapter/**/*.rs text eol=lf
examples/plugins/aho-corasick-adapter/**/*.toml text eol=lf
examples/plugins/aho-corasick-adapter/**/*.txt text eol=lf
examples/plugins/aho-corasick-adapter/**/*.yml text eol=lf
examples/plugin-platform-native-rust/Cargo.lock text eol=lf
examples/plugin-platform-native-rust/Cargo.toml text eol=lf
examples/plugin-platform-native-rust/LICENSE text eol=lf
examples/plugin-platform-native-rust/*.md text eol=lf
examples/plugin-platform-native-rust/**/*.rs text eol=lf

# Multi-runtime gates freeze SDK bundle bytes from the historical Windows
# release layout. Preserve that reviewed layout in every worktree, while the
# explicitly listed Phase 1 additions retain their reviewed LF bytes.
packages/candlescope-plugin-sdk/src/** text eol=crlf
packages/candlescope-plugin-sdk/src/candlescope_plugin_sdk/platform_v2/chart.py text eol=lf
packages/candlescope-plugin-sdk/src/candlescope_plugin_sdk/platform_v2/render.py text eol=lf
packages/candlescope-plugin-sdk/src/candlescope_plugin_sdk/platform_v2/schemas/manifest-v3.schema.json text eol=lf
packages/candlescope-plugin-sdk/examples/platform-v2/hello-command.manifest.json text eol=crlf
packages/candlescope-plugin-sdk/tests/fixtures/hello_command_transcript_v2.json text eol=crlf
packages/candlescope-plugin-sdk/tests/fixtures/platform_v3/*.json text eol=lf

# Phase 8 freezes the Rust WASM SDK lockfile and source tree.
packages/candlescope-plugin-sdk-rust-wasm/Cargo.lock text eol=lf
packages/candlescope-plugin-sdk-rust-wasm/Cargo.toml text eol=lf
packages/candlescope-plugin-sdk-rust-wasm/LICENSE text eol=lf
packages/candlescope-plugin-sdk-rust-wasm/*.md text eol=lf
packages/candlescope-plugin-sdk-rust-wasm/src/** text eol=lf

# Python strategy bundles reject CRLF at the runtime boundary. Make every SDK
# source, schema, fixture, and official template checkout byte-stable on Windows.
packages/candlescope-backtest-sdk/** text eol=lf
backend/app/backtest/strategy/python_author_schemas/** text eol=lf
