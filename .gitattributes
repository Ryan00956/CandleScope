examples/plugins/aho-corasick-adapter/source-lock.json text eol=lf
examples/plugins/aho-corasick-adapter/build-receipt.json text eol=lf
examples/plugins/aho-corasick-adapter/.cargo/config.toml text eol=lf
examples/plugins/aho-corasick-adapter/Cargo.lock text eol=lf
examples/plugins/aho-corasick-adapter/Cargo.toml text eol=lf
examples/plugins/aho-corasick-adapter/scripts/build_release.py text eol=lf
examples/plugins/aho-corasick-adapter/src/** text eol=lf

