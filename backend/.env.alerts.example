# Alert webhook delivery is fail-closed and disabled by default.
ALERT_WEBHOOK_ENABLED=0

# Required when ALERT_WEBHOOK_ENABLED=1 unless signature enforcement is
# explicitly disabled. Use a high-entropy secret and keep it out of rules.
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_REQUIRE_SIGNATURE=1

# Required exact destination hostnames, comma separated. URL redirects are not
# followed, and a hostname outside this list is rejected before it is queued.
ALERT_WEBHOOK_ALLOWED_HOSTS=hooks.example.com

# HTTP and private/link-local/loopback destinations remain denied by default.
ALERT_WEBHOOK_ALLOW_HTTP=0
ALERT_WEBHOOK_ALLOW_PRIVATE_NETWORK=0

# Retry and request bounds.
ALERT_WEBHOOK_TIMEOUT_MS=5000
ALERT_WEBHOOK_MAX_ATTEMPTS=5
ALERT_WEBHOOK_BASE_RETRY_MS=1000
ALERT_WEBHOOK_MAX_RETRY_MS=300000
ALERT_WEBHOOK_POLL_MS=1000
ALERT_WEBHOOK_MAX_PAYLOAD_BYTES=262144
ALERT_WEBHOOK_RETAIN_DELIVERED=5000
ALERT_WEBHOOK_RETAIN_DEAD_LETTER=1000

# Optional. Defaults beside alerts.json under CANDLE_DATA_DIR.
# ALERT_WEBHOOK_OUTBOX_PATH=H:\path\to\alerts-outbox.sqlite3
