# Replay is opt-in. v2 is the default product after the core gate is enabled.
# Copy selected values into a local .env; do not commit data paths.
REPLAY_ENABLED=0
REPLAY_PRODUCT_V2_ENABLED=1
REPLAY_DB_PATH=./data/replay.db

# BAR replay defaults to the immutable Parquet history plane. The live K-line
# SQLite database is not consulted. `legacy_sqlite` is rollback-only.
REPLAY_BAR_SOURCE=archive
REPLAY_HISTORY_ARCHIVE_DIR=./data/replay-history

# Phase 0 frozen safety ceilings. Overrides may tighten, not exceed, these values.
REPLAY_MAX_ACTIVE_SESSIONS=8
REPLAY_COMMAND_QUEUE_SIZE=256
REPLAY_EVENT_BUFFER_SIZE=10000
REPLAY_MAX_EMIT_FPS=30
REPLAY_MAX_WARMUP_BARS=5000
REPLAY_MAX_BAR_DATASET_ROWS=100000
REPLAY_MAX_HORIZON_DAYS=30
REPLAY_TRADE_PAGE_ROWS=50000
REPLAY_CHECKPOINT_EVENT_INTERVAL=10000
REPLAY_CHECKPOINT_VIRTUAL_MS=300000
REPLAY_EVENT_SUBSCRIBER_QUEUE=256
REPLAY_CONTROLLER_TTL_SECONDS=10
REPLAY_IDLE_TTL_SECONDS=3600

# Phase 7/18 immutable segment storage. Download and automatic GC remain
# independently default-off; manual GC always requires a fresh dry-run hash.
REPLAY_SEGMENT_DOWNLOAD_WORKER_ENABLED=0
REPLAY_SEGMENT_AUTO_GC_ENABLED=0
REPLAY_SEGMENT_MAX_ARCHIVE_BYTES=1099511627776

# Phase 8 projection/state-materialization optimization. Keep off for the
# proven FULL_EVENT_SCAN rollback path; correctness never depends on it.
REPLAY_FAST_FORWARD_OPTIMIZATION_ENABLED=0

# Phase 9 verified Binance USD-M snapshot + ordered diff-depth archive.
# Keep disabled until an operator import has passed schema, checksum, range,
# snapshot bridge and U/u/pu continuity verification. This is BOOK_ASSISTED;
# it never claims exchange queue position.
REPLAY_HISTORICAL_BOOK_ENABLED=0
REPLAY_HISTORICAL_BOOK_MAX_ARCHIVE_BYTES=1099511627776

# Phase 16 exact account-history inputs. No production capture is bundled.
REPLAY_ACCOUNT_HISTORY_ENABLED=0
REPLAY_ACCOUNT_HISTORY_MAX_ARCHIVE_BYTES=137438953472

# KLINES_DB_PATH is live/cache storage. BAR replay ignores it in archive mode.
KLINES_DB_PATH=./data/replay-dev/source-candlescope.db
RAW_AGG_TRADE_ARCHIVE_DIR=./data/replay-dev/raw_agg_trades
# Keep disabled unless every selected partition passes checksum and exact coverage audit.
RAW_AGG_TRADE_ARCHIVE_ENABLED=0
