{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://candlescope.local/schemas/python-strategy-bundle-v1.json",
  "title": "CandleScope Python strategy bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "entrypoint",
    "signalClock",
    "outputModes",
    "requiredFeatures",
    "warmup",
    "parameters",
    "reproducibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": "candlescope.python-strategy-bundle/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "signalClock": {
      "const": "BAR_CLOSE"
    },
    "outputModes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["SIGNAL", "TARGET_POSITION", "ORDER_INTENT"]
      }
    },
    "requiredFeatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "warmup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["PARAMETER_MAX", "FIXED_BARS"]
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        }
      }
    },
    "parameters": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "reproducibility": {
      "enum": [
        "DETERMINISTIC_CPU_LOCKED",
        "SEEDED_CPU_LOCKED",
        "BEST_EFFORT_LOCAL",
        "RECORDED_OUTPUT_ONLY"
      ]
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "default"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "enum": ["integer", "number", "boolean", "string"]
        },
        "default": true,
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    }
  }
}
