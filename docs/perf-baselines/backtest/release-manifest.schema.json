{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candlescope.backtest-release/1",
  "title": "CandleScope backtest release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commit",
    "parent",
    "createdAt",
    "flags",
    "databaseSchema",
    "engineVersion",
    "providerProtocol",
    "reportSchema",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "candlescope.backtest-release/1"
    },
    "commit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64
    },
    "parent": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64
    },
    "createdAt": {
      "type": "string",
      "minLength": 20
    },
    "flags": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["0", "1"]
      },
      "required": ["BACKTEST_ENABLED"],
      "properties": {
        "BACKTEST_ENABLED": { "const": "0" }
      }
    },
    "databaseSchema": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "string", "minLength": 1 },
    "providerProtocol": { "const": "strategy-provider/1" },
    "reportSchema": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "tests",
              "benchmark",
              "soak",
              "rollback",
              "no_lookahead",
              "hash_equivalence",
              "browser",
              "provider_recovery",
              "migration",
              "flags_off_boot"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
