# Optional. Leave unset for local Vite development; vite.config.js proxies /api to localhost:18080.
# Set this only when the frontend must call a backend outside the Vite proxy.
VITE_API_BASE=http://127.0.0.1:18080/api/v1

# Optional. Override the local Vite dev server port.
VITE_DEV_PORT=15173

# Optional. Override the local Vite /api proxy target.
VITE_API_PROXY_TARGET=http://127.0.0.1:18080

# Chart-first strategy tester rollout. Keep disabled until the phased UI,
# browser, capacity, and release gates are complete.
VITE_CHART_STRATEGY_TESTER_ENABLED=0
VITE_CHART_TRADE_EXPLANATION_ENABLED=0
VITE_CHART_RUN_COMPARE_ENABLED=0
VITE_CHART_STRATEGY_AUTO_RUN_ENABLED=0

# Optional Phase 1 drawing-coordinate rollout switch. Keep `batch` for normal
# use; `parity` compares canonical batch/scalar resolution and `scalar` is the
# emergency rollback path. Saved drawing data is identical in all three modes.
VITE_DRAWING_COORDINATE_PROJECTOR=batch

# Phase 2 drawing-authority rollout. Document authority is the default when
# this variable is unset. Set `legacy` only for an emergency rollback to the
# primitive-authoritative persistence lifecycle; both modes use the same
# legacy-compatible SavedDrawing[] storage format.
VITE_DRAWING_DOCUMENT_AUTHORITY=document

# Drawing renderer rollout. `scene-canary` is the release/default path and
# renders all migrated kinds through one composite static owner. `legacy` is
# the emergency rollback; `shadow` keeps legacy visible while an invisible
# retained scene records parity/performance evidence. Full `scene` remains
# reserved and fail-closed until Phase 9 deletion gates pass. Values are mount locked.
VITE_DRAWING_ENGINE_MODE=scene-canary

# Phase 5 interaction surface. With DRAWING_ENGINE_MODE=scene-canary, `overlay`
# moves live ink, hover, selection and gesture previews to two pointer-
# transparent DPR canvases. `overlay` is the release/default path. Other engine
# modes fail closed to `legacy`; set this value to `legacy` for a scoped
# interaction rollback without changing document data.
VITE_DRAWING_INTERACTION_OVERLAY=overlay

# Phase 6 raster backend. `worker` keeps exactly one scene/document and uses a
# latest-wins worker for bounded prepared draw results. `main-thread` is the
# rollback path: it keeps the same scene with frame-scheduled low-LOD rendering and
# never reattaches one primitive per drawing. Values are mount locked.
VITE_DRAWING_RASTER_BACKEND=worker
