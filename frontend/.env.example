# Optional. Leave unset for local Vite development; vite.config.js proxies /api to localhost:18080.
# Set this only when the frontend must call a backend outside the Vite proxy.
VITE_API_BASE=http://127.0.0.1:18080/api/v1

# Optional. Override the local Vite dev server port.
VITE_DEV_PORT=15173

# Optional. Override the local Vite /api proxy target.
VITE_API_PROXY_TARGET=http://127.0.0.1:18080
