# Optional. Leave unset for local Vite development; vite.config.js proxies /api to localhost:18080.
# Set this only when the frontend must call a backend outside the Vite proxy.
VITE_API_BASE=http://127.0.0.1:18080/api/v1

# Optional. Override the local Vite dev server port.
VITE_DEV_PORT=15173

# Optional. Override the local Vite /api proxy target.
VITE_API_PROXY_TARGET=http://127.0.0.1:18080

# Optional Phase 1 drawing-coordinate rollout switch. Keep `batch` for normal
# use; `parity` compares canonical batch/scalar resolution and `scalar` is the
# emergency rollback path. Saved drawing data is identical in all three modes.
VITE_DRAWING_COORDINATE_PROJECTOR=batch

# Phase 2 drawing-authority rollout. Document authority is the default when
# this variable is unset. Set `legacy` only for an emergency rollback to the
# primitive-authoritative persistence lifecycle; both modes use the same
# legacy-compatible SavedDrawing[] storage format.
VITE_DRAWING_DOCUMENT_AUTHORITY=document
