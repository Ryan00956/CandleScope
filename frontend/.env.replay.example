# This flag only controls the live-page entry. It is not authentication or authorization.
# The backend REPLAY_ENABLED capability remains authoritative for direct replay page access.
VITE_REPLAY_ENTRY_ENABLED=0
VITE_REPLAY_PRODUCT_V2_ENABLED=0

# Dedicated worktree development endpoints; Phase 0-6 keep the entry flag disabled.
VITE_API_PROXY_TARGET=http://127.0.0.1:18082
VITE_DEV_PORT=15175
