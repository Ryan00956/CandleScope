{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "perf:soak:1h": "node scripts/perf-baseline.mjs --url http://127.0.0.1:15173/ --duration-ms 3960000 --min-heap-duration-ms 3600000 --sample-ms 5000 --out ../docs/perf-baselines/2026-07-release-1h.json --phase release-1h",
    "perf:soak:4h": "node scripts/perf-baseline.mjs --url http://127.0.0.1:15173/ --duration-ms 14760000 --min-heap-duration-ms 14400000 --sample-ms 5000 --out ../docs/perf-baselines/2026-07-release-4h.json --phase release-4h",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "smoke:chart-types": "node scripts/smoke.mjs --url http://127.0.0.1:15173/ --chart-type-matrix --no-seed-indicators",
    "smoke:export": "node scripts/smoke.mjs --url http://127.0.0.1:15173/ --export-matrix --drawing-check --overlay-heavy",
    "smoke:release": "node scripts/smoke.mjs --url http://127.0.0.1:15173/ --chart-type-matrix --export-matrix --drawing-check --overlay-heavy",
    "test:drawing": "node --test src/features/drawings/__tests__/*.test.js"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "html-to-image": "^1.11.13",
    "lightweight-charts": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.3.1"
  }
}
