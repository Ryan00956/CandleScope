{
  "name": "frontend",
  "description": "CandleScope native multi-chart desktop shell and web frontend",
  "author": "CandleScope Contributors",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "build": {
    "appId": "io.candlescope.desktop",
    "productName": "CandleScope",
    "asar": true,
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "app/**/*",
          "requirements.txt"
        ]
      },
      {
        "from": "../packages/candlescope-plugin-sdk/src",
        "to": "packages/candlescope-plugin-sdk/src",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "public/brand/candlescope-mark-compact.svg",
      "target": [
        "dir"
      ]
    }
  },
  "overrides": {
    "dompurify": "3.4.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "capacity:multi-chart": "node scripts/multi-chart-capacity.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:i18n": "tsx scripts/check-i18n.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --test --test-concurrency=4 \"scripts/*.test.mjs\" \"src/**/*.test.{ts,tsx}\"",
    "test:serial": "tsx --test --test-concurrency=1 \"scripts/*.test.mjs\" \"src/**/*.test.{ts,tsx}\"",
    "test:dev": "node scripts/run-tests.mjs dev",
    "test:check": "node scripts/run-tests.mjs check",
    "test:full": "node scripts/run-tests.mjs full",
    "test:profile": "node scripts/run-tests.mjs profile",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:replay": "tsx --test --test-concurrency=4 \"src/features/replay/**/*.test.{ts,tsx}\" \"src/app/__tests__/marketPageFrame.test.tsx\"",
    "test:backtest": "tsx --test --test-concurrency=4 \"src/features/backtest/**/*.test.{ts,tsx}\"",
    "test:research-data": "tsx --test --test-concurrency=4 \"src/features/research-data/**/*.test.{ts,tsx}\" \"src/features/strategy-research/**/*.test.{ts,tsx}\" \"src/features/local-data/**/*.test.{ts,tsx}\"",
    "smoke:backtest": "node scripts/backtest-api-smoke.mjs --duration-ms 1 --max-cycles 1",
    "smoke:strategy-research": "node scripts/strategy-research-smoke.mjs",
    "soak:backtest": "node scripts/backtest-m10-api-soak.mjs --duration-ms 3600000 --output ../output/backtest-m10-api-soak.json",
    "check:plugins": "node scripts/check-plugin-platform.mjs",
    "check": "npm run check:architecture && npm run check:plugins && npm run check:i18n && npm run typecheck && npm run lint && npm test && npm run test:desktop && npm run build",
    "desktop:dev": "electron desktop/main.mjs",
    "desktop:package:dir": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/desktop-phase6-package.ps1",
    "desktop:spike": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/desktop-phase6-spike.ps1",
    "desktop:release:phase6": "node scripts/desktop-phase6-release.mjs --create ../output/playwright/multi-chart-phase6/desktop-spike.json --restore ../output/playwright/multi-chart-phase6/desktop-restore.json --packaged ../output/playwright/multi-chart-phase6/desktop-packaged.json --out ../docs/perf-baselines/multi-chart-workspace/phase6-desktop-shell-20260807.json",
    "desktop:spike:phase7": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/desktop-phase7-spike.ps1",
    "desktop:release:phase7": "node scripts/desktop-phase7-release.mjs --w1 ../output/playwright/multi-chart-phase7/desktop-phase7-w1.json --w2 ../output/playwright/multi-chart-phase7/desktop-phase7-w2.json --out ../docs/perf-baselines/multi-chart-workspace/phase7-workspace-bus-20260807.json",
    "desktop:spike:phase8": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/desktop-phase8-spike.ps1",
    "desktop:rollback:phase8": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/desktop-phase8-rollback.ps1",
    "desktop:package:phase8": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/desktop-phase8-package.ps1",
    "desktop:validate:phase8": "node scripts/phase8-full-validation.mjs --out ../docs/perf-baselines/multi-chart-workspace/phase8-full-validation-20260807.json",
    "desktop:release:phase8": "node scripts/phase8-release.mjs --phase7 ../docs/perf-baselines/multi-chart-workspace/phase7-workspace-bus-20260807.json --w3 ../output/playwright/multi-chart-phase8/desktop-phase8-w3.json --soak ../output/playwright/multi-chart-phase8/desktop-phase8-soak.json --f1 ../output/playwright/multi-chart-phase8/desktop-phase8-f1.json --f2 ../output/playwright/multi-chart-phase8/desktop-phase8-f2.json --f3 ../output/playwright/multi-chart-phase8/desktop-phase8-f3.json --rollback ../docs/perf-baselines/multi-chart-workspace/phase8-flag-rollback-20260807.json --package ../docs/perf-baselines/multi-chart-workspace/phase8-package-fresh-process-20260807.json --validation ../docs/perf-baselines/multi-chart-workspace/phase8-full-validation-20260807.json --out ../docs/perf-baselines/multi-chart-workspace/phase8-release-20260807.json",
    "desktop:soak:phase8:4h": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/desktop-phase8-spike.ps1 -Mode SOAK -DurationMs 14400000 -SampleMs 60000",
    "test:desktop": "node --test \"desktop/*.test.mjs\"",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "perf:drawing": "node scripts/drawing-performance.mjs",
    "monitor:indicators": "node scripts/indicator-stack-monitor.mjs",
    "perf:drawing:soak:1h": "node scripts/drawing-performance.mjs --phase phase9",
    "audit:drawing:rollback-drills": "node scripts/drawing-rollback-drills-cli.mjs --run-component-tests --allow-incomplete",
    "check:drawing:rollback-drills": "node scripts/drawing-rollback-drills-cli.mjs --run-component-tests",
    "perf:soak:1h": "node scripts/perf-baseline.mjs --url http://127.0.0.1:15173/ --duration-ms 3960000 --min-heap-duration-ms 3600000 --sample-ms 5000 --out ../docs/perf-baselines/2026-07-release-1h.json --phase release-1h",
    "perf:soak:4h": "node scripts/perf-baseline.mjs --url http://127.0.0.1:15173/ --duration-ms 14760000 --min-heap-duration-ms 14400000 --sample-ms 5000 --out ../docs/perf-baselines/2026-07-release-4h.json --phase release-4h",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "tsx scripts/smoke.mjs",
    "smoke:replay": "node scripts/replay-soak.mjs --allow-short --duration-ms 10000 --cycles 1 --projection-events 10000 --sample-ms 5000",
    "smoke:replay:v2": "node scripts/replay-soak.mjs --allow-short --duration-ms 10000 --cycles 1 --projection-events 10000 --sample-ms 5000",
    "stress:replay:orders": "node scripts/replay-soak.mjs --allow-short --duration-ms 10000 --cycles 10 --projection-events 10000 --sample-ms 5000 --out ../docs/perf-baselines/replay-v2-order-advisory-stress.json",
    "soak:replay": "node scripts/replay-soak.mjs",
    "soak:replay:stability": "node scripts/replay-soak.mjs --duration-ms 3600000 --cycles 100 --projection-events 1000000 --sample-ms 60000 --out ../docs/perf-baselines/replay-v2-browser-stability-60m.json",
    "soak:replay:v2:stability": "node scripts/replay-soak.mjs --duration-ms 3600000 --cycles 100 --projection-events 1000000 --sample-ms 60000 --out ../docs/perf-baselines/replay-v2-browser-stability-60m.json",
    "soak:replay:4h": "node scripts/replay-soak.mjs --observation-only --duration-ms 14400000 --cycles 100 --projection-events 1000000 --sample-ms 60000 --out ../docs/perf-baselines/replay-v2-browser-observation-4h.json",
    "soak:replay:v2:4h": "node scripts/replay-soak.mjs --observation-only --duration-ms 14400000 --cycles 100 --projection-events 1000000 --sample-ms 60000 --out ../docs/perf-baselines/replay-v2-browser-observation-4h.json",
    "drill:replay:rollback": "node scripts/replay-v2-rollback-drill.mjs",
    "drill:replay:v2:rollback": "node scripts/replay-v2-rollback-drill.mjs",
    "smoke:chart-types": "tsx scripts/smoke.mjs --url http://127.0.0.1:15173/ --chart-type-matrix --no-seed-indicators",
    "smoke:export": "tsx scripts/smoke.mjs --url http://127.0.0.1:15173/ --export-matrix --drawing-check --overlay-heavy",
    "smoke:release": "tsx scripts/smoke.mjs --url http://127.0.0.1:15173/ --chart-type-matrix --export-matrix --drawing-check --overlay-heavy",
    "smoke:drawing:controlled": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/drawing-controlled-cdp-smoke.ps1",
    "check:drawing:rollback-drills:browser": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/drawing-rollback-drills-browser.ps1",
    "test:drawing": "tsx --test --test-concurrency=4 \"src/features/drawings/**/*.test.{ts,tsx}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "html-to-image": "^1.11.13",
    "lightweight-charts": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.1"
  }
}
