{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "tsx --test \"scripts/*.test.mjs\" \"src/**/*.test.{ts,tsx}\"",
    "test:replay": "tsx --test \"src/features/replay/**/*.test.{ts,tsx}\" \"src/app/__tests__/marketPageFrame.test.tsx\"",
    "check:plugins": "node scripts/check-plugin-platform.mjs",
    "check": "npm run check:architecture && npm run check:plugins && npm run typecheck && npm run lint && npm test && npm run build",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "perf:drawing": "node scripts/drawing-performance.mjs",
    "monitor:indicators": "node scripts/indicator-stack-monitor.mjs",
    "perf:drawing:soak:1h": "node scripts/drawing-performance.mjs --phase phase9",
    "audit:drawing:rollback-drills": "node scripts/drawing-rollback-drills-cli.mjs --run-component-tests --allow-incomplete",
    "check:drawing:rollback-drills": "node scripts/drawing-rollback-drills-cli.mjs --run-component-tests",
    "perf:soak:1h": "node scripts/perf-baseline.mjs --url http://127.0.0.1:15173/ --duration-ms 3960000 --min-heap-duration-ms 3600000 --sample-ms 5000 --out ../docs/perf-baselines/2026-07-release-1h.json --phase release-1h",
    "perf:soak:4h": "node scripts/perf-baseline.mjs --url http://127.0.0.1:15173/ --duration-ms 14760000 --min-heap-duration-ms 14400000 --sample-ms 5000 --out ../docs/perf-baselines/2026-07-release-4h.json --phase release-4h",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "tsx scripts/smoke.mjs",
    "smoke:replay": "node scripts/replay-soak.mjs --allow-short --duration-ms 10000 --cycles 1 --projection-events 10000 --sample-ms 5000",
    "smoke:replay:v2": "node scripts/replay-soak.mjs --allow-short --duration-ms 10000 --cycles 1 --projection-events 10000 --sample-ms 5000",
    "soak:replay": "node scripts/replay-soak.mjs",
    "soak:replay:4h": "node scripts/replay-soak.mjs --duration-ms 14400000 --cycles 100 --projection-events 1000000 --sample-ms 60000 --out ../docs/perf-baselines/replay-v2-browser-soak-20260722.json",
    "soak:replay:v2:4h": "node scripts/replay-soak.mjs --duration-ms 14400000 --cycles 100 --projection-events 1000000 --sample-ms 60000 --out ../docs/perf-baselines/replay-v2-browser-soak-20260722.json",
    "drill:replay:rollback": "node scripts/replay-v2-rollback-drill.mjs",
    "drill:replay:v2:rollback": "node scripts/replay-v2-rollback-drill.mjs",
    "smoke:chart-types": "tsx scripts/smoke.mjs --url http://127.0.0.1:15173/ --chart-type-matrix --no-seed-indicators",
    "smoke:export": "tsx scripts/smoke.mjs --url http://127.0.0.1:15173/ --export-matrix --drawing-check --overlay-heavy",
    "smoke:release": "tsx scripts/smoke.mjs --url http://127.0.0.1:15173/ --chart-type-matrix --export-matrix --drawing-check --overlay-heavy",
    "smoke:drawing:controlled": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/drawing-controlled-cdp-smoke.ps1",
    "check:drawing:rollback-drills:browser": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/drawing-rollback-drills-browser.ps1",
    "test:drawing": "tsx --test \"src/features/drawings/**/*.test.{ts,tsx}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "html-to-image": "^1.11.13",
    "lightweight-charts": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.1"
  }
}
