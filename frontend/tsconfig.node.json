{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": [
    "scripts/**/*.ts",
    "scripts/**/*.tsx",
    "src/**/__tests__/**/*.ts",
    "src/**/__tests__/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/types/**/*.d.ts",
    "src/test/**/*.ts",
    "src/test/**/*.tsx"
  ],
  "exclude": ["dist", "node_modules"]
}
