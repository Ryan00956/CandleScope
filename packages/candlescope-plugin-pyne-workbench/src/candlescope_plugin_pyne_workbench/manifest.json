            "schema": {
              "properties": {
                "source": {
                  "title": "Pyne ソース"
                },
                "paramsJson": {
                  "title": "パラメータ JSON"
                },
                "lookbackBars": {
                  "title": "遡及本数"
                }
              }
            }
          },
          "ko": {
            "title": "현재 차트에서 Pyne 실행",
            "schema": {
              "properties": {
                "source": {
                  "title": "Pyne 소스"
                },
                "paramsJson": {
                  "title": "파라미터 JSON"
