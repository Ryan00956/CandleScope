{
  "schemaVersion": 2,
  "plugin": {
    "id": "candlescope.pyne-workbench",
    "name": "Pyne Workbench",
    "version": "0.1.0",
    "publisher": "candlescope",
    "license": "GPL-3.0-only",
    "engines": {
      "candlescope": ">=0.4.0 <0.5.0"
    }
  },
  "backend": {
    "entrypoints": [
      {
        "id": "main",
        "pythonModule": "candlescope_plugin_pyne_workbench.plugin",
        "resourceProfile": "standard",
        "activationEvents": [
          "onCommand",
          "onView"
        ]
      },
      {
        "id": "pyne-workbench",
        "pythonModule": "candlescope_plugin_pyne_workbench.strategy_entrypoint",
        "resourceProfile": "standard",
        "activationEvents": [
          "onCommand"
        ]
      }
    ]
  },
  "frontend": {
    "assetsRoot": "web",
    "surfaces": [
      {
        "id": "workbench-view",
        "type": "sandbox",
        "entry": "index.html",
        "slot": "side-panel"
      }
    ]
  },
  "contributions": [
    {
      "id": "run",
      "kind": "command/1",
      "title": "Run Pyne on current chart",
      "entrypoint": "main",
      "configuration": {
        "localizations": {
          "zh-CN": {
            "title": "在当前图表运行 Pyne",
            "schema": {
              "properties": {
                "source": {
                  "title": "Pyne 源码"
                },
                "paramsJson": {
                  "title": "参数 JSON"
                },
                "lookbackBars": {
                  "title": "回看 K 线数"
                }
              }
            }
          },
          "es": {
            "title": "Ejecutar Pyne en el gráfico actual",
            "schema": {
              "properties": {
                "source": {
                  "title": "Código fuente Pyne"
                },
                "paramsJson": {
                  "title": "JSON de parámetros"
                },
                "lookbackBars": {
                  "title": "Barras de retrospectiva"
                }
              }
            }
          },
          "fr": {
