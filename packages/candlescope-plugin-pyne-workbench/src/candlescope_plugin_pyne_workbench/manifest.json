              }
            }
          },
          "pt-BR": {
            "title": "Executar Pyne no gráfico atual",
            "schema": {
              "properties": {
                "source": {
                  "title": "Código-fonte Pyne"
                },
                "paramsJson": {
                  "title": "JSON de parâmetros"
                },
                "lookbackBars": {
                  "title": "Barras de lookback"
                }
              }
            }
          },
          "ru": {
            "title": "Запустить Pyne на текущем графике",
            "schema": {
              "properties": {
                "source": {
                  "title": "Исходный код Pyne"
                },
                "paramsJson": {
                  "title": "JSON параметров"
                },
                "lookbackBars": {
                  "title": "Свечей назад"
                }
              }
            }
          }
        },
        "requiresUserAction": true,
        "placements": [
          "commandPalette",
          "topToolbar"
        ],
        "inputSchema": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "paramsJson": {
              "type": "string",
              "maxLength": 16384,
              "default": "{}"
            },
            "lookbackBars": {
              "type": "integer",
              "minimum": 2,
              "maximum": 5000,
              "default": 500
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        }
      }
    },
