{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://candlescope.local/schemas/plugin-manifest-v3.schema.json",
  "title": "CandleScope Plugin Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "plugin",
    "backend",
    "contributions",
    "permissions",
    "probes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "plugin": {
      "$ref": "#/$defs/plugin"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrypoints"
      ],
      "properties": {
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/entrypoint"
          }
        }
      }
    },
    "frontend": {
      "$ref": "#/$defs/frontend"
    },
    "contributions": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/contribution"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "optional"
      ],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/permission"
          }
        },
        "optional": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/permission"
          }
        }
      }
    },
    "probes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/probe"
      }
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "pluginId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "permissionId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*:)(?!.*//).+$"
    },
    "runtimeArgs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 1024,
        "pattern": "^[^\\u0000\\r\\n]*$"
      }
    },
    "operatingSystems": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "linux",
          "macos",
          "windows"
        ]
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "arm64",
          "x86_64"
        ]
      }
    },
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "maxLength": 262144
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 10000,
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    },
    "jsonObject": {
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "version",
        "publisher",
        "license",
        "engines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/pluginId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "publisher": {
          "$ref": "#/$defs/localId"
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "engines": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candlescope"
          ],
          "properties": {
            "candlescope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "runtime",
        "transport",
        "resourceProfile",
        "activationEvents"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "runtime": {
          "oneOf": [
            {
              "$ref": "#/$defs/pythonModuleRuntime"
            },
            {
              "$ref": "#/$defs/nativeExecutableRuntime"
            },
            {
              "$ref": "#/$defs/javaJarRuntime"
            },
            {
              "$ref": "#/$defs/nodeModuleRuntime"
            },
            {
              "$ref": "#/$defs/wasmComponentRuntime"
            }
          ]
        },
        "transport": {
          "const": "jsonl/1"
        },
        "resourceProfile": {
          "enum": [
            "minimal",
            "standard",
            "service"
          ]
        },
        "activationEvents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "onCommand",
              "onView",
              "onSchedule",
              "onMarketSubscription",
              "onStartup",
              "onBacktestRun"
            ]
          }
        }
      }
    },
    "pythonModuleRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runtimeId",
        "module"
      ],
      "properties": {
        "kind": {
          "const": "python-module"
        },
        "runtimeId": {
          "$ref": "#/$defs/localId"
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "interpreterArgs": {
          "$ref": "#/$defs/runtimeArgs"
        }
      }
    },
    "nativeExecutableRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "operatingSystems",
        "architectures"
      ],
      "properties": {
        "kind": {
          "const": "native-executable"
        },
        "artifact": {
          "$ref": "#/$defs/artifactPath"
        },
        "operatingSystems": {
          "$ref": "#/$defs/operatingSystems"
        },
        "architectures": {
          "$ref": "#/$defs/architectures"
        },
        "args": {
          "$ref": "#/$defs/runtimeArgs"
        }
      }
    },
    "javaJarRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "runtimeId",
        "mainClass"
      ],
      "properties": {
        "kind": {
          "const": "java-jar"
        },
        "artifact": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactPath"
            },
            {
              "pattern": "\\.jar$"
            }
          ]
        },
        "runtimeId": {
          "$ref": "#/$defs/localId"
        },
        "mainClass": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)+$"
        },
        "jvmArgs": {
          "$ref": "#/$defs/runtimeArgs"
        }
      }
    },
    "nodeModuleRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "runtimeId"
      ],
      "properties": {
        "kind": {
          "const": "node-module"
        },
        "artifact": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactPath"
            },
            {
              "pattern": "\\.(?:cjs|js|mjs)$"
            }
          ]
        },
        "runtimeId": {
          "$ref": "#/$defs/localId"
        },
        "nodeArgs": {
          "$ref": "#/$defs/runtimeArgs"
        }
      }
    },
    "wasmComponentRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact",
        "runtimeId",
        "export"
      ],
      "properties": {
        "kind": {
          "const": "wasm-component"
        },
        "artifact": {
          "allOf": [
            {
              "$ref": "#/$defs/artifactPath"
            },
            {
              "pattern": "\\.wasm$"
            }
          ]
        },
        "runtimeId": {
          "$ref": "#/$defs/localId"
        },
        "export": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
        },
        "wasiProfile": {
          "enum": [
            "none",
            "wasi-preview1",
            "wasi-preview2"
          ]
        },
        "args": {
          "$ref": "#/$defs/runtimeArgs"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetsRoot",
        "surfaces"
      ],
      "properties": {
        "assetsRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![\\\\/])(?!.*\\.\\.)(?!.*:).+$"
        },
        "surfaces": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "entry",
              "slot"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/localId"
              },
              "type": {
                "enum": [
                  "declarative",
                  "sandbox"
                ]
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?![\\\\/])(?!.*\\.\\.)(?!.*:).+$"
              },
              "slot": {
                "$ref": "#/$defs/localId"
              }
            }
          }
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "entrypoint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*/[1-9][0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "entrypoint": {
          "$ref": "#/$defs/localId"
        },
        "configuration": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/permissionId"
        },
        "scope": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "sha256",
        "entrypoint"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "const": "controlTranscript"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "entrypoint": {
          "$ref": "#/$defs/localId"
        }
      }
    }
  }
}
