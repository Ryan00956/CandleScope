  "script": "indicator(\"Request Daily Context Capture\", overlay=True)\ndaily_time = request.security(\"BTCUSDT\", \"1D\", \"time\", gaps=barmerge.gaps_on)\ndaily_time_close, daily_close, tf_multiplier, tf_intraday, tf_daily = request.security(\n    \"BTCUSDT\",\n    \"1D\",\n    lambda ctx: (\n        ctx.time_close,\n        ctx.close,\n        ctx.timeframe_info.multiplier,\n        1 if ctx.timeframe_info.isintraday else 0,\n        1 if ctx.timeframe_info.isdaily else 0,\n    ),\n    gaps=barmerge.gaps_on,\n)\nprovider_time, provider_open, provider_high, provider_low, provider_close, provider_volume = request.security(\n    \"BTCUSDT\",\n    \"1D\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n    gaps=barmerge.gaps_on,\n)\nplot(daily_time, \"Daily Time\")\nplot(daily_time_close, \"Daily Time Close\")\nplot(daily_time_close - daily_time, \"Daily Duration\")\nplot(daily_close, \"Daily Close\")\nplot(tf_multiplier, \"Daily TF Multiplier\")\nplot(tf_intraday, \"Daily TF Intraday\")\nplot(tf_daily, \"Daily TF Daily\")\nplot(provider_time, \"Daily Provider Time\")\nplot(provider_open, \"Daily Open\")\nplot(provider_high, \"Daily High\")\nplot(provider_low, \"Daily Low\")\nplot(provider_close, \"Daily Provider Close\")\nplot(provider_volume, \"Daily Volume\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 48\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\nindicator(\"Pyne Request Capture - Daily Context\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n_daily_time = request.security(syminfo.tickerid, \"1D\", time, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n[_daily_time_close, _daily_close, _tf_multiplier, _tf_intraday, _tf_daily] = request.security(syminfo.tickerid, \"1D\", [time_close, close, timeframe.multiplier, timeframe.isintraday ? 1 : 0, timeframe.isdaily ? 1 : 0], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n[_provider_time, _provider_open, _provider_high, _provider_low, _provider_close, _provider_volume] = request.security(syminfo.tickerid, \"1D\", [time, open, high, low, close, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\nplot(_pyne_capture_active ? _daily_time : na, \"Daily Time\")\nplot(_pyne_capture_active ? _daily_time_close / 1000 : na, \"Daily Time Close\")\nplot(_pyne_capture_active ? (_daily_time_close - _daily_time) / 1000 : na, \"Daily Duration\")\nplot(_pyne_capture_active ? _daily_close : na, \"Daily Close\")\nplot(_pyne_capture_active ? _tf_multiplier : na, \"Daily TF Multiplier\")\nplot(_pyne_capture_active ? _tf_intraday : na, \"Daily TF Intraday\")\nplot(_pyne_capture_active ? _tf_daily : na, \"Daily TF Daily\")\nplot(_pyne_capture_active ? _provider_time : na, \"Daily Provider Time\")\nplot(_pyne_capture_active ? _provider_open : na, \"Daily Open\")\nplot(_pyne_capture_active ? _provider_high : na, \"Daily High\")\nplot(_pyne_capture_active ? _provider_low : na, \"Daily Low\")\nplot(_pyne_capture_active ? _provider_close : na, \"Daily Provider Close\")\nplot(_pyne_capture_active ? _provider_volume : na, \"Daily Volume\")\n",
