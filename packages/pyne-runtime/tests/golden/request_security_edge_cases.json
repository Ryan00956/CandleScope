  "script": "indicator(\"Request Edge Golden\", overlay=True)\nhigher = request.security(\"BTCUSDT\", \"2H\", \"close\")\ngapped = request.security(\"BTCUSDT\", \"2H\", \"close\", gaps=barmerge.gaps_on)\nahead = request.security(\"BTCUSDT\", \"2H\", \"close\", lookahead=barmerge.lookahead_on)\nprevious = request.security(\"BTCUSDT\", \"2H\", close[1])\nrequested_open, requested_condition = request.security(\n    \"BTCUSDT\",\n    \"2H\",\n    lambda ctx: (ctx.open, ctx.when(ctx.close > 250, ctx.high, ctx.low)),\n)\nlower = request.security_lower_tf(\"BTCUSDT\", \"1\", lambda ctx: ctx.close)\nlower_range = request.security_lower_tf(\"BTCUSDT\", \"1\", lambda ctx: ctx.high - ctx.low)\nplot(higher, \"Higher\")\nplot(gapped, \"Gapped\")\nplot(ahead, \"Ahead\")\nplot(previous, \"Previous\")\nplot(requested_open, \"Requested Open\")\nplot(requested_condition, \"Requested Conditional\")\nplot(lower.size(), \"Lower Count\")\nplot(lower.last(), \"Lower Last\")\nplot(lower.avg(), \"Lower Avg\")\nplot(lower.get(1, default=-1), \"Lower Second\")\nplot(lower[1].size(), \"Previous Lower Count\")\nplot(lower_range.sum(), \"Lower Range Sum\")\n",
