  "script": "indicator(\"Request Expression Context Capture\", overlay=True)\nexpr_mid, expr_conditional, expr_prev_body = request.security(\n    \"BTCUSDT\",\n    \"240\",\n    lambda ctx: (\n        (ctx.high + ctx.low) / 2,\n        ctx.when(ctx.close > ctx.open, ctx.high, ctx.low),\n        ctx.close[1] - ctx.open[1],\n    ),\n    gaps=barmerge.gaps_on,\n)\nprovider_time, provider_open, provider_high, provider_low, provider_close, provider_volume = request.security(\n    \"BTCUSDT\",\n    \"240\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n    gaps=barmerge.gaps_on,\n)\nplot(expr_mid, \"Expr Mid\")\nplot(expr_conditional, \"Expr Conditional\")\nplot(expr_prev_body, \"Expr Previous Body\")\nplot(provider_time, \"Expr Provider Time\")\nplot(provider_open, \"Expr Open\")\nplot(provider_high, \"Expr High\")\nplot(provider_low, \"Expr Low\")\nplot(provider_close, \"Expr Provider Close\")\nplot(provider_volume, \"Expr Volume\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\nindicator(\"Pyne Request Capture - Expression Context\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n[_expr_mid, _expr_conditional, _expr_prev_body] = request.security(syminfo.tickerid, \"240\", [(high + low) / 2, close > open ? high : low, close[1] - open[1]], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n[_provider_time, _provider_open, _provider_high, _provider_low, _provider_close, _provider_volume] = request.security(syminfo.tickerid, \"240\", [time, open, high, low, close, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\nplot(_pyne_capture_active ? _expr_mid : na, \"Expr Mid\")\nplot(_pyne_capture_active ? _expr_conditional : na, \"Expr Conditional\")\nplot(_pyne_capture_active ? _expr_prev_body : na, \"Expr Previous Body\")\nplot(_pyne_capture_active ? _provider_time : na, \"Expr Provider Time\")\nplot(_pyne_capture_active ? _provider_open : na, \"Expr Open\")\nplot(_pyne_capture_active ? _provider_high : na, \"Expr High\")\nplot(_pyne_capture_active ? _provider_low : na, \"Expr Low\")\nplot(_pyne_capture_active ? _provider_close : na, \"Expr Provider Close\")\nplot(_pyne_capture_active ? _provider_volume : na, \"Expr Volume\")\n",
