  "script": "indicator(\"Request HTF Capture\", overlay=True)\nhigher_close = request.security(\"BTCUSDT\", \"240\", \"close\")\nhigher_gapped = request.security(\"BTCUSDT\", \"240\", \"close\", gaps=barmerge.gaps_on)\nhigher_ahead = request.security(\"BTCUSDT\", \"240\", \"close\", lookahead=barmerge.lookahead_on)\nprevious_close = request.security(\"BTCUSDT\", \"240\", close[1])\nrequested_open, requested_high, requested_low = request.security(\n    \"BTCUSDT\",\n    \"240\",\n    lambda ctx: (ctx.open, ctx.high, ctx.low),\n    gaps=barmerge.gaps_on,\n)\nprovider_time, provider_open, provider_high, provider_low, provider_close, provider_volume = request.security(\n    \"BTCUSDT\",\n    \"240\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n    gaps=barmerge.gaps_on,\n)\nplot(higher_close, \"HTF Close\")\nplot(higher_gapped, \"HTF Close Gapped\")\nplot(higher_ahead, \"HTF Close Lookahead\")\nplot(previous_close, \"HTF Previous Close\")\nplot(requested_open, \"HTF Requested Open\")\nplot(requested_high, \"HTF Requested High\")\nplot(requested_low, \"HTF Requested Low\")\nplot(provider_time, \"HTF Time\")\nplot(provider_open, \"HTF Open\")\nplot(provider_high, \"HTF High\")\nplot(provider_low, \"HTF Low\")\nplot(provider_close, \"HTF Provider Close\")\nplot(provider_volume, \"HTF Volume\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\nindicator(\"Pyne Request Capture - HTF Alignment\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n_higher_close = request.security(syminfo.tickerid, \"240\", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)\n_higher_gapped = request.security(syminfo.tickerid, \"240\", close, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n_higher_ahead = request.security(syminfo.tickerid, \"240\", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)\n_previous_close = request.security(syminfo.tickerid, \"240\", close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)\n[_requested_open, _requested_high, _requested_low] = request.security(syminfo.tickerid, \"240\", [open, high, low], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n[_provider_time, _provider_open, _provider_high, _provider_low, _provider_close, _provider_volume] = request.security(syminfo.tickerid, \"240\", [time, open, high, low, close, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\nplot(_pyne_capture_active ? _higher_close : na, \"HTF Close\")\nplot(_pyne_capture_active ? _higher_gapped : na, \"HTF Close Gapped\")\nplot(_pyne_capture_active ? _higher_ahead : na, \"HTF Close Lookahead\")\nplot(_pyne_capture_active ? _previous_close : na, \"HTF Previous Close\")\nplot(_pyne_capture_active ? _requested_open : na, \"HTF Requested Open\")\nplot(_pyne_capture_active ? _requested_high : na, \"HTF Requested High\")\nplot(_pyne_capture_active ? _requested_low : na, \"HTF Requested Low\")\nplot(_pyne_capture_active ? _provider_time : na, \"HTF Time\")\nplot(_pyne_capture_active ? _provider_open : na, \"HTF Open\")\nplot(_pyne_capture_active ? _provider_high : na, \"HTF High\")\nplot(_pyne_capture_active ? _provider_low : na, \"HTF Low\")\nplot(_pyne_capture_active ? _provider_close : na, \"HTF Provider Close\")\nplot(_pyne_capture_active ? _provider_volume : na, \"HTF Volume\")\n",
