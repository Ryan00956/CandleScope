  "script": "indicator(\"Request Invalid Symbol Ignore Capture\", overlay=True)\ninvalid_close = request.security(\n    \"BINANCE:PYNE_MISSING_SYMBOL\",\n    \"240\",\n    close,\n    gaps=barmerge.gaps_on,\n    ignore_invalid_symbol=True,\n)\nprovider_time, provider_open, provider_high, provider_low, provider_close, provider_volume = request.security(\n    \"BTCUSDT\",\n    \"240\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n    gaps=barmerge.gaps_on,\n)\nplot(invalid_close, \"Invalid Close\")\nplot(na(invalid_close), \"Invalid Is NA\")\nplot(nz(invalid_close, -999), \"Invalid NZ Fallback\")\nplot(provider_time, \"Control Provider Time\")\nplot(provider_open, \"Control Open\")\nplot(provider_high, \"Control High\")\nplot(provider_low, \"Control Low\")\nplot(provider_close, \"Control Provider Close\")\nplot(provider_volume, \"Control Volume\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_invalid_symbol = input.string(\"BINANCE:PYNE_MISSING_SYMBOL\", \"Pyne capture: invalid symbol\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\n\nindicator(\"Pyne Request Capture - Invalid Symbol Ignore\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n\n_invalid_close = request.security(_pyne_capture_invalid_symbol, \"240\", close, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)\n[_provider_time, _provider_open, _provider_high, _provider_low, _provider_close, _provider_volume] = request.security(syminfo.tickerid, \"240\", [time, open, high, low, close, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n\nplot(_pyne_capture_active ? _invalid_close : na, \"Invalid Close\")\nplot(_pyne_capture_active ? (na(_invalid_close) ? 1 : 0) : na, \"Invalid Is NA\")\nplot(_pyne_capture_active ? nz(_invalid_close, -999) : na, \"Invalid NZ Fallback\")\nplot(_pyne_capture_active ? _provider_time : na, \"Control Provider Time\")\nplot(_pyne_capture_active ? _provider_open : na, \"Control Open\")\nplot(_pyne_capture_active ? _provider_high : na, \"Control High\")\nplot(_pyne_capture_active ? _provider_low : na, \"Control Low\")\nplot(_pyne_capture_active ? _provider_close : na, \"Control Provider Close\")\nplot(_pyne_capture_active ? _provider_volume : na, \"Control Volume\")\n",
