  "script": "indicator(\"Request LTF Capture\", overlay=True)\nlower_close = request.security_lower_tf(\"BTCUSDT\", \"60\", lambda ctx: ctx.close)\nlower_mid, lower_range = request.security_lower_tf(\n    \"BTCUSDT\",\n    \"60\",\n    lambda ctx: ((ctx.high + ctx.low) / 2, ctx.high - ctx.low),\n)\nltf_time, ltf_open, ltf_high, ltf_low, ltf_provider_close, ltf_volume = request.security_lower_tf(\n    \"BTCUSDT\",\n    \"60\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n)\nplot(lower_close.size(), \"LTF Count\")\nplot(lower_close.first(), \"LTF First Close\")\nplot(lower_close.get(1, default=0), \"LTF Second Close\")\nplot(lower_close.last(), \"LTF Last Close\")\nplot(lower_close.sum(), \"LTF Sum Close\")\nplot(lower_close.avg(), \"LTF Avg Close\")\nplot(lower_mid.first(), \"LTF Tuple Mid First\")\nplot(lower_range.sum(), \"LTF Tuple Range Sum\")\nplot(ltf_time.get(0), \"LTF Time 0\")\nplot(ltf_open.get(0), \"LTF Open 0\")\nplot(ltf_high.get(0), \"LTF High 0\")\nplot(ltf_low.get(0), \"LTF Low 0\")\nplot(ltf_provider_close.get(0), \"LTF Provider Close 0\")\nplot(ltf_volume.get(0), \"LTF Volume 0\")\nplot(ltf_time.get(1), \"LTF Time 1\")\nplot(ltf_open.get(1), \"LTF Open 1\")\nplot(ltf_high.get(1), \"LTF High 1\")\nplot(ltf_low.get(1), \"LTF Low 1\")\nplot(ltf_provider_close.get(1), \"LTF Provider Close 1\")\nplot(ltf_volume.get(1), \"LTF Volume 1\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 4\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\n_pyne_ltf_get(array<float> arr, int idx, float fallback) =>\n    array.size(arr) > idx ? array.get(arr, idx) : fallback\n_pyne_ltf_last(array<float> arr, float fallback) =>\n    array.size(arr) > 0 ? array.get(arr, array.size(arr) - 1) : fallback\nindicator(\"Pyne Request Capture - LTF Grouping\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n_ltf_close = request.security_lower_tf(syminfo.tickerid, \"60\", close)\n[_ltf_mid, _ltf_range] = request.security_lower_tf(syminfo.tickerid, \"60\", [(high + low) / 2, high - low])\n[_ltf_time, _ltf_open, _ltf_high, _ltf_low, _ltf_provider_close, _ltf_volume] = request.security_lower_tf(syminfo.tickerid, \"60\", [time, open, high, low, close, volume])\nplot(_pyne_capture_active ? array.size(_ltf_close) : na, \"LTF Count\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_close, 0, na) : na, \"LTF First Close\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_close, 1, 0.0) : na, \"LTF Second Close\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_ltf_close, na) : na, \"LTF Last Close\")\nplot(_pyne_capture_active ? array.sum(_ltf_close) : na, \"LTF Sum Close\")\nplot(_pyne_capture_active ? array.avg(_ltf_close) : na, \"LTF Avg Close\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_mid, 0, na) : na, \"LTF Tuple Mid First\")\nplot(_pyne_capture_active ? array.sum(_ltf_range) : na, \"LTF Tuple Range Sum\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_time, 0, na) : na, \"LTF Time 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_open, 0, na) : na, \"LTF Open 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_high, 0, na) : na, \"LTF High 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_low, 0, na) : na, \"LTF Low 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_provider_close, 0, na) : na, \"LTF Provider Close 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_volume, 0, na) : na, \"LTF Volume 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_time, 1, na) : na, \"LTF Time 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_open, 1, na) : na, \"LTF Open 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_high, 1, na) : na, \"LTF High 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_low, 1, na) : na, \"LTF Low 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_provider_close, 1, na) : na, \"LTF Provider Close 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_volume, 1, na) : na, \"LTF Volume 1\")\n",
