  "script": "indicator(\"Request Lower TF Invalid Symbol Expression Ignore Capture\", overlay=True)\ninvalid_mid = request.security_lower_tf(\n    \"BINANCE:PYNE_MISSING_SYMBOL\",\n    \"15\",\n    lambda ctx: (ctx.high + ctx.low) / 2,\n    ignore_invalid_symbol=True,\n)\nplot(invalid_mid.size(), \"Invalid LTF Expr Mid Count\")\nplot(invalid_mid.first(default=-111), \"Invalid LTF Expr Mid First\")\nplot(invalid_mid.last(default=-222), \"Invalid LTF Expr Mid Last\")\nplot(invalid_mid.sum(default=0), \"Invalid LTF Expr Mid Sum\")\nplot(invalid_mid.avg(default=-333), \"Invalid LTF Expr Mid Avg\")\nplot(invalid_mid.size() == 0, \"Invalid LTF Expr Mid Is Empty\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_invalid_symbol = input.string(\"BINANCE:PYNE_MISSING_SYMBOL\", \"Pyne capture: invalid symbol\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\n_pyne_ltf_size(array<float> arr) =>\n    not na(arr) ? array.size(arr) : 0\n_pyne_ltf_first(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.get(arr, 0) : fallback\n_pyne_ltf_last(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.get(arr, array.size(arr) - 1) : fallback\n_pyne_ltf_sum(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.sum(arr) : fallback\n_pyne_ltf_avg(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.avg(arr) : fallback\n\nindicator(\"Pyne Request Capture - Lower TF Invalid Symbol Expression Ignore\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n\n_invalid_mid = request.security_lower_tf(_pyne_capture_invalid_symbol, \"15\", (high + low) / 2, ignore_invalid_symbol=true)\nplot(_pyne_capture_active ? _pyne_ltf_size(_invalid_mid) : na, \"Invalid LTF Expr Mid Count\")\nplot(_pyne_capture_active ? _pyne_ltf_first(_invalid_mid, -111) : na, \"Invalid LTF Expr Mid First\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_invalid_mid, -222) : na, \"Invalid LTF Expr Mid Last\")\nplot(_pyne_capture_active ? _pyne_ltf_sum(_invalid_mid, 0) : na, \"Invalid LTF Expr Mid Sum\")\nplot(_pyne_capture_active ? _pyne_ltf_avg(_invalid_mid, -333) : na, \"Invalid LTF Expr Mid Avg\")\nplot(_pyne_capture_active ? (_pyne_ltf_size(_invalid_mid) == 0 ? 1 : 0) : na, \"Invalid LTF Expr Mid Is Empty\")\n",
