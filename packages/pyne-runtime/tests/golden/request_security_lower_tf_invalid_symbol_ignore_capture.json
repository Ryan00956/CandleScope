  "script": "indicator(\"Request Lower TF Invalid Symbol Ignore Capture\", overlay=True)\ninvalid_ltf = request.security_lower_tf(\n    \"BINANCE:PYNE_MISSING_SYMBOL\",\n    \"15\",\n    close,\n    ignore_invalid_symbol=True,\n)\nplot(invalid_ltf.size(), \"Invalid LTF Count\")\nplot(invalid_ltf.first(default=-999), \"Invalid LTF First Fallback\")\nplot(invalid_ltf.last(default=-999), \"Invalid LTF Last Fallback\")\nplot(invalid_ltf.sum(default=0), \"Invalid LTF Sum Fallback\")\nplot(invalid_ltf.avg(default=-999), \"Invalid LTF Avg Fallback\")\nplot(invalid_ltf.size() == 0, \"Invalid LTF Is Empty\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_invalid_symbol = input.string(\"BINANCE:PYNE_MISSING_SYMBOL\", \"Pyne capture: invalid symbol\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\n_pyne_ltf_size(array<float> arr) =>\n    not na(arr) ? array.size(arr) : 0\n_pyne_ltf_first(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.get(arr, 0) : fallback\n_pyne_ltf_last(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.get(arr, array.size(arr) - 1) : fallback\n_pyne_ltf_sum(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.sum(arr) : fallback\n_pyne_ltf_avg(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.avg(arr) : fallback\n\nindicator(\"Pyne Request Capture - Lower TF Invalid Symbol Ignore\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n\n_invalid_ltf = request.security_lower_tf(_pyne_capture_invalid_symbol, \"15\", close, ignore_invalid_symbol=true)\nplot(_pyne_capture_active ? _pyne_ltf_size(_invalid_ltf) : na, \"Invalid LTF Count\")\nplot(_pyne_capture_active ? _pyne_ltf_first(_invalid_ltf, -999) : na, \"Invalid LTF First Fallback\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_invalid_ltf, -999) : na, \"Invalid LTF Last Fallback\")\nplot(_pyne_capture_active ? _pyne_ltf_sum(_invalid_ltf, 0) : na, \"Invalid LTF Sum Fallback\")\nplot(_pyne_capture_active ? _pyne_ltf_avg(_invalid_ltf, -999) : na, \"Invalid LTF Avg Fallback\")\nplot(_pyne_capture_active ? (_pyne_ltf_size(_invalid_ltf) == 0 ? 1 : 0) : na, \"Invalid LTF Is Empty\")\n",
