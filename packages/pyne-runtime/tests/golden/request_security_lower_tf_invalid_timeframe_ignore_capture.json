  "script": "indicator(\"Request Lower TF Invalid Timeframe Ignore Capture\", overlay=True)\ninvalid_tf = request.security_lower_tf(\n    \"BTCUSDT\",\n    \"240\",\n    close,\n    ignore_invalid_timeframe=True,\n)\nplot(invalid_tf.size(), \"Invalid TF Count\")\nplot(invalid_tf.first(default=-999), \"Invalid TF First Fallback\")\nplot(invalid_tf.last(default=-999), \"Invalid TF Last Fallback\")\nplot(invalid_tf.sum(default=0), \"Invalid TF Sum Fallback\")\nplot(invalid_tf.avg(default=-999), \"Invalid TF Avg Fallback\")\nplot(invalid_tf.size() == 0, \"Invalid TF Is Empty\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\n_pyne_ltf_size(array<float> arr) =>\n    not na(arr) ? array.size(arr) : 0\n_pyne_ltf_first(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.get(arr, 0) : fallback\n_pyne_ltf_last(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.get(arr, array.size(arr) - 1) : fallback\n_pyne_ltf_sum(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.sum(arr) : fallback\n_pyne_ltf_avg(array<float> arr, float fallback) =>\n    _pyne_ltf_size(arr) > 0 ? array.avg(arr) : fallback\n\nindicator(\"Pyne Request Capture - Lower TF Invalid Timeframe Ignore\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n\n_invalid_tf = request.security_lower_tf(syminfo.tickerid, \"240\", close, ignore_invalid_timeframe=true)\nplot(_pyne_capture_active ? _pyne_ltf_size(_invalid_tf) : na, \"Invalid TF Count\")\nplot(_pyne_capture_active ? _pyne_ltf_first(_invalid_tf, -999) : na, \"Invalid TF First Fallback\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_invalid_tf, -999) : na, \"Invalid TF Last Fallback\")\nplot(_pyne_capture_active ? _pyne_ltf_sum(_invalid_tf, 0) : na, \"Invalid TF Sum Fallback\")\nplot(_pyne_capture_active ? _pyne_ltf_avg(_invalid_tf, -999) : na, \"Invalid TF Avg Fallback\")\nplot(_pyne_capture_active ? (_pyne_ltf_size(_invalid_tf) == 0 ? 1 : 0) : na, \"Invalid TF Is Empty\")\n",
