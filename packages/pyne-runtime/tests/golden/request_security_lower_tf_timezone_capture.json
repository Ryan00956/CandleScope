  "script": "indicator(\"Request Lower TF Timezone Capture\", overlay=True)\nutc_hour, shanghai_hour, utc_day, shanghai_day = request.security_lower_tf(\n    \"BTCUSDT\",\n    \"30\",\n    lambda ctx: (\n        time.hour(ctx.time, \"UTC\"),\n        time.hour(ctx.time, \"Asia/Shanghai\"),\n        time.dayofweek(ctx.time, \"UTC\"),\n        time.dayofweek(ctx.time, \"Asia/Shanghai\"),\n    ),\n)\nltf_time, ltf_open, ltf_high, ltf_low, ltf_close, ltf_volume = request.security_lower_tf(\n    \"BTCUSDT\",\n    \"30\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n)\nplot(utc_hour.size(), \"LTF TZ Count\")\nplot(utc_hour.last(), \"LTF TZ UTC Hour Last\")\nplot(shanghai_hour.last(), \"LTF TZ Shanghai Hour Last\")\nplot(utc_day.last(), \"LTF TZ UTC Day Last\")\nplot(shanghai_day.last(), \"LTF TZ Shanghai Day Last\")\nplot(ltf_time.get(0), \"LTF TZ Time 0\")\nplot(ltf_open.get(0), \"LTF TZ Open 0\")\nplot(ltf_high.get(0), \"LTF TZ High 0\")\nplot(ltf_low.get(0), \"LTF TZ Low 0\")\nplot(ltf_close.get(0), \"LTF TZ Close 0\")\nplot(ltf_volume.get(0), \"LTF TZ Volume 0\")\nplot(ltf_time.get(1), \"LTF TZ Time 1\")\nplot(ltf_open.get(1), \"LTF TZ Open 1\")\nplot(ltf_high.get(1), \"LTF TZ High 1\")\nplot(ltf_low.get(1), \"LTF TZ Low 1\")\nplot(ltf_close.get(1), \"LTF TZ Close 1\")\nplot(ltf_volume.get(1), \"LTF TZ Volume 1\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\n_pyne_ltf_get(array<float> arr, int idx, float fallback) =>\n    array.size(arr) > idx ? array.get(arr, idx) : fallback\n_pyne_ltf_last(array<float> arr, float fallback) =>\n    array.size(arr) > 0 ? array.get(arr, array.size(arr) - 1) : fallback\n\nindicator(\"Pyne Request Capture - Lower TF Timezone\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n[_utc_hour, _shanghai_hour, _utc_day, _shanghai_day] = request.security_lower_tf(syminfo.tickerid, \"30\", [hour(time, \"UTC\"), hour(time, \"Asia/Shanghai\"), dayofweek(time, \"UTC\"), dayofweek(time, \"Asia/Shanghai\")])\n[_ltf_time, _ltf_open, _ltf_high, _ltf_low, _ltf_close, _ltf_volume] = request.security_lower_tf(syminfo.tickerid, \"30\", [time, open, high, low, close, volume])\nplot(_pyne_capture_active ? array.size(_utc_hour) : na, \"LTF TZ Count\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_utc_hour, na) : na, \"LTF TZ UTC Hour Last\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_shanghai_hour, na) : na, \"LTF TZ Shanghai Hour Last\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_utc_day, na) : na, \"LTF TZ UTC Day Last\")\nplot(_pyne_capture_active ? _pyne_ltf_last(_shanghai_day, na) : na, \"LTF TZ Shanghai Day Last\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_time, 0, na) : na, \"LTF TZ Time 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_open, 0, na) : na, \"LTF TZ Open 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_high, 0, na) : na, \"LTF TZ High 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_low, 0, na) : na, \"LTF TZ Low 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_close, 0, na) : na, \"LTF TZ Close 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_volume, 0, na) : na, \"LTF TZ Volume 0\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_time, 1, na) : na, \"LTF TZ Time 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_open, 1, na) : na, \"LTF TZ Open 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_high, 1, na) : na, \"LTF TZ High 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_low, 1, na) : na, \"LTF TZ Low 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_close, 1, na) : na, \"LTF TZ Close 1\")\nplot(_pyne_capture_active ? _pyne_ltf_get(_ltf_volume, 1, na) : na, \"LTF TZ Volume 1\")\n",
