  "script": "indicator(\"Request Metadata Capture\", overlay=True)\nmeta_mintick, tf_multiplier, tf_intraday, tf_daily, session_market = request.security(\n    \"BTCUSDT\",\n    \"240\",\n    lambda ctx: (\n        ctx.syminfo.mintick,\n        ctx.timeframe_info.multiplier,\n        1 if ctx.timeframe_info.isintraday else 0,\n        1 if ctx.timeframe_info.isdaily else 0,\n        ctx.when(ctx.session.ismarket, 1, 0),\n    ),\n    gaps=barmerge.gaps_on,\n)\nprovider_time, provider_open, provider_high, provider_low, provider_close, provider_volume = request.security(\n    \"BTCUSDT\",\n    \"240\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n    gaps=barmerge.gaps_on,\n)\nplot(meta_mintick, \"Requested Mintick\")\nplot(tf_multiplier, \"Requested TF Multiplier\")\nplot(tf_intraday, \"Requested TF Intraday\")\nplot(tf_daily, \"Requested TF Daily\")\nplot(session_market, \"Requested Session Market\")\nplot(provider_time, \"HTF Time\")\nplot(provider_open, \"HTF Open\")\nplot(provider_high, \"HTF High\")\nplot(provider_low, \"HTF Low\")\nplot(provider_close, \"HTF Provider Close\")\nplot(provider_volume, \"HTF Volume\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\nindicator(\"Pyne Request Capture - Metadata\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n[_meta_mintick, _tf_multiplier, _tf_intraday, _tf_daily, _session_market] = request.security(syminfo.tickerid, \"240\", [syminfo.mintick, timeframe.multiplier, timeframe.isintraday ? 1 : 0, timeframe.isdaily ? 1 : 0, session.ismarket ? 1 : 0], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n[_provider_time, _provider_open, _provider_high, _provider_low, _provider_close, _provider_volume] = request.security(syminfo.tickerid, \"240\", [time, open, high, low, close, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\nplot(_pyne_capture_active ? _meta_mintick : na, \"Requested Mintick\")\nplot(_pyne_capture_active ? _tf_multiplier : na, \"Requested TF Multiplier\")\nplot(_pyne_capture_active ? _tf_intraday : na, \"Requested TF Intraday\")\nplot(_pyne_capture_active ? _tf_daily : na, \"Requested TF Daily\")\nplot(_pyne_capture_active ? _session_market : na, \"Requested Session Market\")\nplot(_pyne_capture_active ? _provider_time : na, \"HTF Time\")\nplot(_pyne_capture_active ? _provider_open : na, \"HTF Open\")\nplot(_pyne_capture_active ? _provider_high : na, \"HTF High\")\nplot(_pyne_capture_active ? _provider_low : na, \"HTF Low\")\nplot(_pyne_capture_active ? _provider_close : na, \"HTF Provider Close\")\nplot(_pyne_capture_active ? _provider_volume : na, \"HTF Volume\")\n",
