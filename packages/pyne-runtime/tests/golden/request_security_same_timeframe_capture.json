  "script": "indicator(\"Request Same Timeframe Capture\", overlay=True)\nsame_close = request.security(\"BTCUSDT\", \"60\", \"close\")\nsame_prev = request.security(\"BTCUSDT\", \"60\", lambda ctx: ctx.close[1])\nsame_tuple_open, same_tuple_mid = request.security(\n    \"BTCUSDT\",\n    \"60\",\n    lambda ctx: (ctx.open, (ctx.high + ctx.low) / 2),\n)\nsame_gaps = request.security(\"BTCUSDT\", \"60\", \"close\", gaps=barmerge.gaps_on)\nsame_ahead = request.security(\"BTCUSDT\", \"60\", \"close\", lookahead=barmerge.lookahead_on)\nprovider_time, provider_open, provider_high, provider_low, provider_close, provider_volume = request.security(\n    \"BTCUSDT\",\n    \"60\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n    gaps=barmerge.gaps_on,\n)\nplot(same_close, \"Same Close\")\nplot(same_prev, \"Same Previous Close\")\nplot(same_tuple_open, \"Same Tuple Open\")\nplot(same_tuple_mid, \"Same Tuple Mid\")\nplot(same_gaps, \"Same Gaps Close\")\nplot(same_ahead, \"Same Lookahead Close\")\nplot(provider_time, \"Same Provider Time\")\nplot(provider_open, \"Same Provider Open\")\nplot(provider_high, \"Same Provider High\")\nplot(provider_low, \"Same Provider Low\")\nplot(provider_close, \"Same Provider Close\")\nplot(provider_volume, \"Same Provider Volume\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\nindicator(\"Pyne Request Capture - Same Timeframe\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n_same_close = request.security(syminfo.tickerid, \"60\", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)\n_same_prev = request.security(syminfo.tickerid, \"60\", close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)\n[_same_tuple_open, _same_tuple_mid] = request.security(syminfo.tickerid, \"60\", [open, (high + low) / 2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)\n_same_gaps = request.security(syminfo.tickerid, \"60\", close, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n_same_ahead = request.security(syminfo.tickerid, \"60\", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)\n[_provider_time, _provider_open, _provider_high, _provider_low, _provider_close, _provider_volume] = request.security(syminfo.tickerid, \"60\", [time, open, high, low, close, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\nplot(_pyne_capture_active ? _same_close : na, \"Same Close\")\nplot(_pyne_capture_active ? _same_prev : na, \"Same Previous Close\")\nplot(_pyne_capture_active ? _same_tuple_open : na, \"Same Tuple Open\")\nplot(_pyne_capture_active ? _same_tuple_mid : na, \"Same Tuple Mid\")\nplot(_pyne_capture_active ? _same_gaps : na, \"Same Gaps Close\")\nplot(_pyne_capture_active ? _same_ahead : na, \"Same Lookahead Close\")\nplot(_pyne_capture_active ? _provider_time : na, \"Same Provider Time\")\nplot(_pyne_capture_active ? _provider_open : na, \"Same Provider Open\")\nplot(_pyne_capture_active ? _provider_high : na, \"Same Provider High\")\nplot(_pyne_capture_active ? _provider_low : na, \"Same Provider Low\")\nplot(_pyne_capture_active ? _provider_close : na, \"Same Provider Close\")\nplot(_pyne_capture_active ? _provider_volume : na, \"Same Provider Volume\")\n",
