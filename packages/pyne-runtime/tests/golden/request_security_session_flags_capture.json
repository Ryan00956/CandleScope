  "script": "indicator(\"Request Session Flags Capture\", overlay=True)\nmarket, first, last = request.security(\n    \"BTCUSDT\",\n    \"360\",\n    lambda ctx: (\n        ctx.session.ismarket,\n        ctx.session.isfirstbar,\n        ctx.session.islastbar,\n    ),\n    gaps=barmerge.gaps_on,\n)\nprovider_time, provider_open, provider_high, provider_low, provider_close, provider_volume = request.security(\n    \"BTCUSDT\",\n    \"360\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n    gaps=barmerge.gaps_on,\n)\nplot(market, \"Requested Session Market\")\nplot(first, \"Requested Session First\")\nplot(last, \"Requested Session Last\")\nplot(provider_time, \"Session Provider Time\")\nplot(provider_open, \"Session Open\")\nplot(provider_high, \"Session High\")\nplot(provider_low, \"Session Low\")\nplot(provider_close, \"Session Provider Close\")\nplot(provider_volume, \"Session Volume\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\nindicator(\"Pyne Request Capture - Session Flags\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n[_requested_market, _requested_first, _requested_last] = request.security(syminfo.tickerid, \"360\", [session.ismarket ? 1 : 0, session.isfirstbar ? 1 : 0, session.islastbar ? 1 : 0], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n[_provider_time, _provider_open, _provider_high, _provider_low, _provider_close, _provider_volume] = request.security(syminfo.tickerid, \"360\", [time, open, high, low, close, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\nplot(_pyne_capture_active ? _requested_market : na, \"Requested Session Market\")\nplot(_pyne_capture_active ? _requested_first : na, \"Requested Session First\")\nplot(_pyne_capture_active ? _requested_last : na, \"Requested Session Last\")\nplot(_pyne_capture_active ? _provider_time : na, \"Session Provider Time\")\nplot(_pyne_capture_active ? _provider_open : na, \"Session Open\")\nplot(_pyne_capture_active ? _provider_high : na, \"Session High\")\nplot(_pyne_capture_active ? _provider_low : na, \"Session Low\")\nplot(_pyne_capture_active ? _provider_close : na, \"Session Provider Close\")\nplot(_pyne_capture_active ? _provider_volume : na, \"Session Volume\")\n",
