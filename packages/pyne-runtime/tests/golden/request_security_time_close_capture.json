  "script": "indicator(\"Request Time Close Capture\", overlay=True)\nhtf_time = request.security(\"BTCUSDT\", \"240\", \"time\", gaps=barmerge.gaps_on)\nhtf_time_close = request.security(\"BTCUSDT\", \"240\", \"time_close\", gaps=barmerge.gaps_on)\nhtf_close = request.security(\"BTCUSDT\", \"240\", \"close\", gaps=barmerge.gaps_on)\nprovider_time, provider_open, provider_high, provider_low, provider_close, provider_volume = request.security(\n    \"BTCUSDT\",\n    \"240\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n    gaps=barmerge.gaps_on,\n)\nplot(htf_time, \"HTF Time\")\nplot(htf_time_close, \"HTF Time Close\")\nplot(htf_time_close - htf_time, \"HTF Duration\")\nplot(htf_close, \"HTF Close\")\nplot(provider_open, \"HTF Open\")\nplot(provider_high, \"HTF High\")\nplot(provider_low, \"HTF Low\")\nplot(provider_close, \"HTF Provider Close\")\nplot(provider_volume, \"HTF Volume\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\nindicator(\"Pyne Request Capture - Time Close\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n_htf_time = request.security(syminfo.tickerid, \"240\", time, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n_htf_time_close = request.security(syminfo.tickerid, \"240\", time_close, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n_htf_close = request.security(syminfo.tickerid, \"240\", close, gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n[_provider_time, _provider_open, _provider_high, _provider_low, _provider_close, _provider_volume] = request.security(syminfo.tickerid, \"240\", [time, open, high, low, close, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\nplot(_pyne_capture_active ? _htf_time : na, \"HTF Time\")\nplot(_pyne_capture_active ? _htf_time_close / 1000 : na, \"HTF Time Close\")\nplot(_pyne_capture_active ? (_htf_time_close - _htf_time) / 1000 : na, \"HTF Duration\")\nplot(_pyne_capture_active ? _htf_close : na, \"HTF Close\")\nplot(_pyne_capture_active ? _provider_open : na, \"HTF Open\")\nplot(_pyne_capture_active ? _provider_high : na, \"HTF High\")\nplot(_pyne_capture_active ? _provider_low : na, \"HTF Low\")\nplot(_pyne_capture_active ? _provider_close : na, \"HTF Provider Close\")\nplot(_pyne_capture_active ? _provider_volume : na, \"HTF Volume\")\n",
