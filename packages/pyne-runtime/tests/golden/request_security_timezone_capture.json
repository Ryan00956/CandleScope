  "script": "indicator(\"Request Timezone Capture\", overlay=True)\nutc_hour, shanghai_hour, utc_day, shanghai_day = request.security(\n    \"BTCUSDT\",\n    \"240\",\n    lambda ctx: (\n        time.hour(ctx.time, \"UTC\"),\n        time.hour(ctx.time, \"Asia/Shanghai\"),\n        time.dayofweek(ctx.time, \"UTC\"),\n        time.dayofweek(ctx.time, \"Asia/Shanghai\"),\n    ),\n    gaps=barmerge.gaps_on,\n)\nprovider_time, provider_open, provider_high, provider_low, provider_close, provider_volume = request.security(\n    \"BTCUSDT\",\n    \"240\",\n    (\"time\", \"open\", \"high\", \"low\", \"close\", \"volume\"),\n    gaps=barmerge.gaps_on,\n)\nplot(utc_hour, \"Requested UTC Hour\")\nplot(shanghai_hour, \"Requested Shanghai Hour\")\nplot(utc_day, \"Requested UTC Day\")\nplot(shanghai_day, \"Requested Shanghai Day\")\nplot(provider_time, \"Timezone Provider Time\")\nplot(provider_open, \"Timezone Open\")\nplot(provider_high, \"Timezone High\")\nplot(provider_low, \"Timezone Low\")\nplot(provider_close, \"Timezone Provider Close\")\nplot(provider_volume, \"Timezone Volume\")\n",
  "pine_script": "//@version=5\n_pyne_capture_bars = 12\n_pyne_capture_use_last_bars = input.bool(true, \"Pyne capture: use last chart bars\")\n_pyne_capture_start_time = input.int(1704067200000, \"Pyne capture: start time (ms)\")\n_pyne_capture_start_hit = time >= _pyne_capture_start_time and (na(time[1]) or time[1] < _pyne_capture_start_time)\n_pyne_capture_from_time = ta.barssince(_pyne_capture_start_hit)\n_pyne_capture_from_last = bar_index - (last_bar_index - _pyne_capture_bars)\n_pyne_capture_index = _pyne_capture_use_last_bars ? _pyne_capture_from_last : _pyne_capture_from_time\n_pyne_capture_active = _pyne_capture_index >= 0 and _pyne_capture_index < _pyne_capture_bars\nindicator(\"Pyne Request Capture - Timezone\", overlay=true)\nplot(_pyne_capture_active ? _pyne_capture_index : na, \"Pyne Capture Index\")\n[_utc_hour, _shanghai_hour, _utc_day, _shanghai_day] = request.security(syminfo.tickerid, \"240\", [hour(time, \"UTC\"), hour(time, \"Asia/Shanghai\"), dayofweek(time, \"UTC\"), dayofweek(time, \"Asia/Shanghai\")], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\n[_provider_time, _provider_open, _provider_high, _provider_low, _provider_close, _provider_volume] = request.security(syminfo.tickerid, \"240\", [time, open, high, low, close, volume], gaps=barmerge.gaps_on, lookahead=barmerge.lookahead_off)\nplot(_pyne_capture_active ? _utc_hour : na, \"Requested UTC Hour\")\nplot(_pyne_capture_active ? _shanghai_hour : na, \"Requested Shanghai Hour\")\nplot(_pyne_capture_active ? _utc_day : na, \"Requested UTC Day\")\nplot(_pyne_capture_active ? _shanghai_day : na, \"Requested Shanghai Day\")\nplot(_pyne_capture_active ? _provider_time : na, \"Timezone Provider Time\")\nplot(_pyne_capture_active ? _provider_open : na, \"Timezone Open\")\nplot(_pyne_capture_active ? _provider_high : na, \"Timezone High\")\nplot(_pyne_capture_active ? _provider_low : na, \"Timezone Low\")\nplot(_pyne_capture_active ? _provider_close : na, \"Timezone Provider Close\")\nplot(_pyne_capture_active ? _provider_volume : na, \"Timezone Volume\")\n",
