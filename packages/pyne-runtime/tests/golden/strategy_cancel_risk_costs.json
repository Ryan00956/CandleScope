      "name": "risk_lock_cancel_pending_entry_without_commission",
      "source": "pyne-defined deterministic strategy cancel/risk cost semantics",
      "script": "strategy(\"Cancel Risk Cost\", overlay=True, initial_capital=1000, commission_type=strategy.commission.cash_per_order, commission_value=1)\nstrategy.risk.max_drawdown(5, strategy.percent_of_equity)\nstrategy.entry_when(bar_index == 0, \"Long\", strategy.long, qty=10, price=close)\nstrategy.entry(\"Breakout\", strategy.long, qty=1, when=bar_index == 0, stop=120)\nstrategy.order(\"Fade\", strategy.short, qty=1, when=bar_index == 0, stop=80)\nstrategy.cancel(\"Breakout\", when=bar_index == 2, comment=\"Blocked setup\")\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.opentrades.commission(0), \"Open Commission\")\n",
