      "name": "lifecycle_quantities_cancel_and_reject",
      "source": "pyne-defined deterministic strategy replay semantics",
      "script": "strategy(\"Lifecycle Golden\", overlay=True, initial_capital=1000, pyramiding=5)\nstrategy.risk.max_position_size(3)\nstrategy.entry_when(bar_index == 0, \"Long\", strategy.long, qty=5, price=close)\nstrategy.entry(\"Fade\", strategy.short, qty=1, when=bar_index == 0, limit=13)\nstrategy.cancel(\"Fade\", when=bar_index == 1, comment=\"No fade\")\nstrategy.exit(\"Half\", from_entry=\"Long\", qty_percent=50, limit=12, when=bar_index == 2)\nstrategy.entry(\"Breakout\", strategy.long, qty=1, when=bar_index == 0, stop=12)\nstrategy.entry_when(bar_index == 3, \"Cap\", strategy.long, qty=1, price=close)\nstrategy.entry_when(bar_index == 3, \"TooMuch\", strategy.long, qty=1, price=close)\nplot(strategy.position_size, \"Position\")\n",
