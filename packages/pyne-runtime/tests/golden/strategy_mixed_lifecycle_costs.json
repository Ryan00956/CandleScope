      "name": "risk_delayed_oca_cancel_then_cancel_all_costs",
      "source": "pyne-defined deterministic strategy mixed OCA/risk/cancel lifecycle semantics",
      "script": "strategy(\"Risk OCA Cancel Mix\", overlay=True, initial_capital=1000, pyramiding=3, commission_type=strategy.commission.cash_per_order, commission_value=1)\nstrategy.risk.max_intraday_loss(5, strategy.percent_of_equity)\nstrategy.entry_when(bar_index == 0, \"Long\", strategy.long, qty=10, price=close)\nstrategy.entry(\"Breakout\", strategy.long, qty=1, when=bar_index == 0, stop=125, oca_name=\"risk_group\", oca_type=strategy.oca.cancel)\nstrategy.order(\"Fade\", strategy.short, qty=1, when=bar_index == 0, stop=80, oca_name=\"risk_group\", oca_type=strategy.oca.cancel)\nstrategy.entry(\"Trail\", strategy.long, qty=1, when=bar_index == 0, stop=140)\nstrategy.cancel_all(when=bar_index == 4, comment=\"Clean leftovers\")\nstrategy.close_all(when=bar_index == 5, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.closedtrades.commission(0), \"First Closed Commission\")\nplot(strategy.closedtrades.commission(1), \"Last Closed Commission\")\n",
