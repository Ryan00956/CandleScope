    {
      "name": "cash_per_contract_partial_close_allocation",
      "source": "Pyne-defined cash-per-contract partial-close strategy fixture with a Pine-equivalent scaffold for external TradingView export comparison.",
      "script": "strategy(\"Pine Equivalent Contract Partial\", overlay=True, initial_capital=1000, pyramiding=0, commission_type=strategy.commission.cash_per_contract, commission_value=0.25, process_orders_on_close=True)\nstrategy.entry(\"Long\", strategy.long, qty=4, when=bar_index == 0, price=close)\nstrategy.close(\"Long\", when=bar_index == 1, qty_percent=50, price=close)\nstrategy.close_all(when=bar_index == 2, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.profit(0), \"First Closed Profit\")\nplot(strategy.closedtrades.commission(0), \"First Closed Commission\")\nplot(strategy.closedtrades.net_profit(0), \"First Closed Net Profit\")\nplot(strategy.closedtrades.profit(1), \"Last Closed Profit\")\nplot(strategy.closedtrades.commission(1), \"Last Closed Commission\")\nplot(strategy.closedtrades.net_profit(1), \"Last Closed Net Profit\")\n",
      "pine_equivalent": "//@version=5\nstrategy(\"Pine Equivalent Contract Partial\", overlay=true, initial_capital=1000, pyramiding=0, commission_type=strategy.commission.cash_per_contract, commission_value=0.25, process_orders_on_close=true)\nif bar_index == 0\n    strategy.entry(\"Long\", strategy.long, qty=4)\nif bar_index == 1\n    strategy.close(\"Long\", qty_percent=50)\nif bar_index == 2\n    strategy.close_all()\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.profit(0), \"First Closed Profit\")\nplot(strategy.closedtrades.commission(0), \"First Closed Commission\")\nplot(strategy.closedtrades.profit(0) - strategy.closedtrades.commission(0), \"First Closed Net Profit\")\nplot(strategy.closedtrades.profit(1), \"Last Closed Profit\")\nplot(strategy.closedtrades.commission(1), \"Last Closed Commission\")\nplot(strategy.closedtrades.profit(1) - strategy.closedtrades.commission(1), \"Last Closed Net Profit\")\n",
      "pine_equivalent_notes": [
        "Cash-per-contract commission is 0.25 per filled unit.",
        "The partial close allocates half of the entry commission to the first closed trade, and close_all allocates the remaining entry commission to the second closed trade."
      ],
