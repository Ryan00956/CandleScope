    {
      "name": "exit_partial_then_close_all",
      "source": "Pyne-defined partial-exit strategy fixture with a Pine-equivalent scaffold for external TradingView export comparison.",
      "script": "strategy(\"Pine Equivalent Exit Partial\", overlay=True, initial_capital=1000, pyramiding=2, process_orders_on_close=True)\nstrategy.entry(\"A\", strategy.long, qty=1, when=bar_index == 0, price=close)\nstrategy.entry(\"B\", strategy.long, qty=2, when=bar_index == 1, price=close)\nstrategy.exit(\"Exit B Half\", from_entry=\"B\", qty_percent=50, limit=12, when=bar_index == 2)\nstrategy.close_all(when=bar_index == 3, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.opentrades, \"Open Trades\")\nplot(strategy.closedtrades.profit(0), \"First Closed Profit\")\nplot(strategy.closedtrades.profit(1), \"Last Closed Profit\")\n",
      "pine_equivalent": "//@version=5\nstrategy(\"Pine Equivalent Exit Partial\", overlay=true, initial_capital=1000, pyramiding=2, process_orders_on_close=true)\nif bar_index == 0\n    strategy.entry(\"A\", strategy.long, qty=1)\nif bar_index == 1\n    strategy.entry(\"B\", strategy.long, qty=2)\nif bar_index == 2\n    strategy.exit(\"Exit B Half\", from_entry=\"B\", qty_percent=50, limit=12)\nif bar_index == 3\n    strategy.close_all()\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.opentrades, \"Open Trades\")\nplot(strategy.closedtrades.profit(0), \"First Closed Profit\")\nplot(strategy.closedtrades.profit(1), \"Last Closed Profit\")\n",
      "pine_equivalent_notes": [
        "The partial exit targets the B entry lot and closes half of its original quantity.",
        "close_all later closes the remaining A and B lots FIFO."
      ],
