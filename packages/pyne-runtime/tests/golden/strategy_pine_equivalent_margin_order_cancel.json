    {
      "name": "margin_long_rejects_then_small_fill",
      "source": "Pyne-defined margin admission strategy fixture with a Pine-equivalent scaffold for external TradingView export comparison.",
      "script": "strategy(\"Pine Equivalent Margin Long\", overlay=True, initial_capital=1000, margin_long=100, commission_type=strategy.commission.cash_per_order, commission_value=1)\nstrategy.entry(\"Too Big\", strategy.long, qty=20, when=bar_index == 0, price=close)\nstrategy.entry(\"Small\", strategy.long, qty=5, when=bar_index == 0, price=close)\nstrategy.close_all(when=bar_index == 1, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.commission(0), \"Closed Commission\")\n",
      "pine_equivalent": "//@version=5\nstrategy(\"Pine Equivalent Margin Long\", overlay=true, initial_capital=1000, margin_long=100, commission_type=strategy.commission.cash_per_order, commission_value=1, process_orders_on_close=true)\nif bar_index == 0\n    strategy.entry(\"Too Big\", strategy.long, qty=20)\n    strategy.entry(\"Small\", strategy.long, qty=5)\nif bar_index == 1\n    strategy.close_all()\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.commission(0), \"Closed Commission\")\n",
      "pine_equivalent_notes": [
        "The first entry requires more margin than available equity and is rejected without commission.",
        "The smaller entry passes margin admission, then close_all carries entry and close commissions into the closed trade."
      ],
