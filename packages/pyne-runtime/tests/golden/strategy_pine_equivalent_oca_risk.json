    {
      "name": "oca_cancel_waits_for_intraday_risk_reset",
      "source": "Pyne-defined OCA cancel plus intraday-risk strategy fixture with a Pine-equivalent scaffold for external TradingView export comparison.",
      "script": "strategy(\"Pine Equivalent OCA Cancel Risk Reset\", overlay=True, initial_capital=1000, process_orders_on_close=True)\nstrategy.risk.max_intraday_loss(5, strategy.percent_of_equity)\nstrategy.entry(\"Long\", strategy.long, qty=10, when=bar_index == 0, price=close)\nstrategy.entry(\"Breakout\", strategy.long, qty=1, when=bar_index == 0, stop=120, oca_name=\"risk_group\", oca_type=strategy.oca.cancel)\nstrategy.order(\"Fade\", strategy.short, qty=1, when=bar_index == 0, limit=130, oca_name=\"risk_group\", oca_type=strategy.oca.cancel)\nstrategy.close_all(when=bar_index == 2, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.opentrades, \"Open Trades\")\n",
      "pine_equivalent": "//@version=5\nstrategy(\"Pine Equivalent OCA Cancel Risk Reset\", overlay=true, initial_capital=1000, process_orders_on_close=true)\nstrategy.risk.max_intraday_loss(5, strategy.percent_of_equity)\nif bar_index == 0\n    strategy.entry(\"Long\", strategy.long, qty=10)\n    strategy.entry(\"Breakout\", strategy.long, qty=1, stop=120, oca_name=\"risk_group\", oca_type=strategy.oca.cancel)\n    strategy.order(\"Fade\", strategy.short, qty=1, limit=130, oca_name=\"risk_group\", oca_type=strategy.oca.cancel)\nif bar_index == 2\n    strategy.close_all()\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.opentrades, \"Open Trades\")\n",
      "pine_equivalent_notes": [
        "The pending OCA group is submitted before the intraday risk lock.",
        "The stop is touched while the intraday lock is active, then fills after a session reset; the OCA cancel sibling is canceled by that fill.",
        "The Pyne bars use session_isfirstbar metadata to make the reset explicit for host-side replay."
      ],
