      "name": "limit_entry_then_close",
      "source": "Pyne-defined pending limit-entry strategy fixture with a Pine-equivalent scaffold for external TradingView export comparison.",
      "script": "strategy(\"Pine Equivalent Limit Entry\", overlay=True, initial_capital=1000, pyramiding=0)\nstrategy.entry(\"LimitLong\", strategy.long, qty=1, when=bar_index == 0, limit=9)\nstrategy.close(\"LimitLong\", when=bar_index == 2, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\n",
      "pine_equivalent": "//@version=5\nstrategy(\"Pine Equivalent Limit Entry\", overlay=true, initial_capital=1000, pyramiding=0, process_orders_on_close=true)\nif bar_index == 0\n    strategy.entry(\"LimitLong\", strategy.long, qty=1, limit=9)\nif bar_index == 2\n    strategy.close(\"LimitLong\")\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\n",
