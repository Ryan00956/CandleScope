    {
      "name": "pyramiding_two_entries_then_flat",
      "source": "Pyne-defined pyramiding strategy fixture with a Pine-equivalent scaffold for external TradingView export comparison.",
      "script": "strategy(\"Pine Equivalent Pyramiding\", overlay=True, initial_capital=1000, pyramiding=1, process_orders_on_close=True)\nstrategy.entry(\"A\", strategy.long, qty=1, when=bar_index == 0, price=close)\nstrategy.entry(\"B\", strategy.long, qty=1, when=bar_index == 1, price=close)\nstrategy.close_all(when=bar_index == 2, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.profit(0), \"First Closed Profit\")\nplot(strategy.closedtrades.profit(1), \"Last Closed Profit\")\n",
      "pine_equivalent": "//@version=5\nstrategy(\"Pine Equivalent Pyramiding\", overlay=true, initial_capital=1000, pyramiding=1, process_orders_on_close=true)\nif bar_index == 0\n    strategy.entry(\"A\", strategy.long, qty=1)\nif bar_index == 1\n    strategy.entry(\"B\", strategy.long, qty=1)\nif bar_index == 2\n    strategy.close_all()\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.profit(0), \"First Closed Profit\")\nplot(strategy.closedtrades.profit(1), \"Last Closed Profit\")\n",
      "pine_equivalent_notes": [
        "pyramiding=1 permits one same-direction entry; the second same-direction entry is rejected while the first lot remains open.",
        "close_all closes the remaining entry lot after the capture window, so the reference plots still show an open position on the final captured bar."
