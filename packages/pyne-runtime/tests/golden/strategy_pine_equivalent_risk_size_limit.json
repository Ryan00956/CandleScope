    {
      "name": "max_position_size_caps_entry",
      "source": "Pyne-defined max position size strategy fixture with a Pine-equivalent scaffold for external TradingView export comparison.",
      "script": "strategy(\"Pine Equivalent Max Position Size\", overlay=True, initial_capital=1000, pyramiding=2, commission_type=strategy.commission.cash_per_contract, commission_value=0.25, process_orders_on_close=True)\nstrategy.risk.max_position_size(3)\nstrategy.entry(\"Long\", strategy.long, qty=5, when=bar_index == 0, price=close)\nstrategy.entry(\"More\", strategy.long, qty=2, when=bar_index == 1, price=close)\nstrategy.close_all(when=bar_index == 2, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.commission(0), \"Closed Commission\")\n",
      "pine_equivalent": "//@version=5\nstrategy(\"Pine Equivalent Max Position Size\", overlay=true, initial_capital=1000, pyramiding=2, commission_type=strategy.commission.cash_per_contract, commission_value=0.25, process_orders_on_close=true)\nstrategy.risk.max_position_size(3)\nif bar_index == 0\n    strategy.entry(\"Long\", strategy.long, qty=5)\nif bar_index == 1\n    strategy.entry(\"More\", strategy.long, qty=2)\nif bar_index == 2\n    strategy.close_all()\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.commission(0), \"Closed Commission\")\n",
      "pine_equivalent_notes": [
        "max_position_size caps the first requested entry from 5 contracts to 3 contracts.",
        "The later same-direction entry is rejected because the capped position is already at the configured maximum.",
        "process_orders_on_close=true delays market order visibility to the next plotted bar."
      ],
