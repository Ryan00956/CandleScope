      "name": "global_drawdown_lock_rejects_entries",
      "source": "Pyne-defined global drawdown lock strategy fixture with a Pine-equivalent scaffold for external TradingView export comparison.",
      "script": "strategy(\"Pine Equivalent Global Drawdown Lock\", overlay=True, initial_capital=1000, commission_type=strategy.commission.cash_per_order, commission_value=1, process_orders_on_close=True)\nstrategy.risk.max_drawdown(5, strategy.percent_of_equity)\nstrategy.entry(\"Long\", strategy.long, qty=10, when=bar_index == 0, price=close)\nstrategy.entry(\"Blocked Entry\", strategy.long, qty=1, when=bar_index == 2, price=close)\nstrategy.order(\"Blocked Order\", strategy.long, qty=1, when=bar_index == 2, price=close)\nstrategy.close_all(when=bar_index == 2, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.commission(0), \"Closed Commission\")\n",
