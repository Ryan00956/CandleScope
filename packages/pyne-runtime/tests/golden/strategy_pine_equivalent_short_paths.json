    {
      "name": "short_oca_reduce_costs_use_reduced_quantity",
      "source": "Pyne-defined short OCA reduce strategy fixture with a Pine-equivalent scaffold for external TradingView export comparison.",
      "script": "strategy(\"Pine Equivalent Short OCA Reduce\", overlay=True, initial_capital=1000, slippage=1, mintick=0.1, commission_type=strategy.commission.cash_per_contract, commission_value=0.25, process_orders_on_close=True)\nstrategy.entry(\"First\", strategy.short, qty=1, when=bar_index == 0, stop=8, oca_name=\"short_scale\", oca_type=strategy.oca.reduce)\nstrategy.order(\"Second\", strategy.short, qty=2, when=bar_index == 0, stop=7, oca_name=\"short_scale\", oca_type=strategy.oca.reduce)\nstrategy.close_all(when=bar_index == 3, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.commission(0), \"First Closed Commission\")\nplot(strategy.closedtrades.commission(1), \"Last Closed Commission\")\n",
      "pine_equivalent": "//@version=5\nstrategy(\"Pine Equivalent Short OCA Reduce\", overlay=true, initial_capital=1000, slippage=1, commission_type=strategy.commission.cash_per_contract, commission_value=0.25, process_orders_on_close=true)\nif bar_index == 0\n    strategy.entry(\"First\", strategy.short, qty=1, stop=8, oca_name=\"short_scale\", oca_type=strategy.oca.reduce)\n    strategy.order(\"Second\", strategy.short, qty=2, stop=7, oca_name=\"short_scale\", oca_type=strategy.oca.reduce)\nif bar_index == 3\n    strategy.close_all()\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.openprofit, \"Open Profit\")\nplot(strategy.closedtrades, \"Closed Trades\")\nplot(strategy.closedtrades.commission(0), \"First Closed Commission\")\nplot(strategy.closedtrades.commission(1), \"Last Closed Commission\")\n",
