      "name": "multi_lot_entry_reversal_splits_costs_fifo",
      "source": "pyne-defined deterministic strategy reversal lot cost semantics",
      "script": "strategy(\"Multi Lot Reversal Cost\", overlay=True, initial_capital=1000, pyramiding=2, slippage=1, mintick=0.1, commission_type=strategy.commission.cash_per_contract, commission_value=0.25)\nstrategy.entry_when(bar_index == 0, \"A\", strategy.long, qty=1, price=close)\nstrategy.entry_when(bar_index == 1, \"B\", strategy.long, qty=2, price=close)\nstrategy.entry_when(bar_index == 2, \"Short\", strategy.short, qty=2, price=close)\nstrategy.close_all(when=bar_index == 3, price=close)\nplot(strategy.position_size, \"Position\")\nplot(strategy.equity, \"Equity\")\nplot(strategy.netprofit, \"Net Profit\")\nplot(strategy.closedtrades.commission(0), \"First Closed Commission\")\nplot(strategy.closedtrades.commission(2), \"Last Closed Commission\")\n",
