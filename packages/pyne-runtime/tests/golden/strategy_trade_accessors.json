    {
      "name": "trade_accessor_numeric_fields",
      "source": "pyne-defined deterministic strategy trade namespace accessor semantics",
      "script": "strategy(\"Trade Accessors\", overlay=True, initial_capital=1000, pyramiding=3, commission_type=strategy.commission.cash_per_contract, commission_value=0.25)\nstrategy.entry_when(bar_index == 0, \"A\", strategy.long, qty=2, price=close)\nstrategy.entry_when(bar_index == 1, \"B\", strategy.long, qty=1, price=close)\nstrategy.close(\"A\", when=bar_index == 2, qty=1, price=close)\nplot(strategy.closedtrades, \"Closed Count\")\nplot(strategy.opentrades, \"Open Count\")\nplot(strategy.closedtrades.size(0), \"Closed Size\")\nplot(strategy.closedtrades.qty(-1), \"Closed Last Qty\")\nplot(strategy.closedtrades.profit(0), \"Closed Profit\")\nplot(strategy.closedtrades.net_profit(0), \"Closed Net Profit\")\nplot(strategy.closedtrades.commission(0), \"Closed Commission\")\nplot(strategy.closedtrades.entry_price(0), \"Closed Entry Price\")\nplot(strategy.closedtrades.exit_price(0), \"Closed Exit Price\")\nplot(strategy.closedtrades.entry_time(0), \"Closed Entry Time\")\nplot(strategy.closedtrades.exit_time(0), \"Closed Exit Time\")\nplot(strategy.closedtrades.entry_bar_index(0), \"Closed Entry Bar\")\nplot(strategy.closedtrades.exit_bar_index(0), \"Closed Exit Bar\")\nplot(strategy.opentrades.size(0), \"Open First Size\")\nplot(strategy.opentrades.qty(-1), \"Open Last Qty\")\nplot(strategy.opentrades.entry_price(-1), \"Open Last Entry Price\")\nplot(strategy.opentrades.profit(0), \"Open First Profit\")\nplot(strategy.opentrades.profit(-1), \"Open Last Profit\")\nplot(strategy.opentrades.commission(0), \"Open First Commission\")\nplot(strategy.opentrades.entry_time(-1), \"Open Last Entry Time\")\nplot(strategy.opentrades.entry_bar_index(0), \"Open First Entry Bar\")\nplot(strategy.opentrades.entry_bar_index(-1), \"Open Last Entry Bar\")\n",
